# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for Claude-powered chat)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Provider for chat (anthropic or openai)
LLM_PROVIDER=anthropic

# Chat API Port (default: 3001)
PORT=3001

# OpenRouter API Key (for cheaper model alternatives)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Model (default: claude-3.5-haiku)
# Options: claude-3-haiku, claude-3.5-haiku, gemini-flash, gemini-pro, gpt-4o-mini, llama-3.1-70b, llama-3.3-70b, mistral-large, qwen-72b
OPENROUTER_MODEL=claude-3.5-haiku
