# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for Claude-powered chat)
# If not provided, will fall back to OpenAI for chat
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Provider for chat (anthropic or openai)
# Default: anthropic
LLM_PROVIDER=anthropic

# Chat API Port (default: 3001)
PORT=3001
