# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for Claude-powered chat)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Provider for chat (anthropic or openai)
LLM_PROVIDER=anthropic

# Chat API Port (default: 3001)
PORT=3001

# OpenRouter API Key (for cheaper model alternatives)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Model (default: claude-3.5-haiku)
# Options: claude-3-haiku, claude-3.5-haiku, gemini-flash, gemini-pro, gpt-4o-mini, llama-3.1-70b, llama-3.3-70b, mistral-large, qwen-72b
OPENROUTER_MODEL=claude-3.5-haiku

# --- Server security (server/index.ts) -------------------------------------

# Admin token required (as an `x-admin-token` header) to call POST /api/regenerate,
# which can trigger a FULL, paid re-embedding of the entire archive via OpenAI.
# REQUIRED to use that endpoint at all — if unset, it refuses every request
# (fails closed) rather than being silently open. Generate a long random value,
# e.g.: openssl rand -hex 32
ADMIN_API_TOKEN=your-long-random-admin-token-here

# Comma-separated list of browser origins allowed to call this API (CORS).
# Include the production site and any local dev origin you use.
ALLOWED_ORIGINS=https://opencouncil.xyz,http://localhost:8080

# Optional: override the default per-IP rate limits on POST /api/chat
# (defaults: 15/minute, 200/day — see server/rate-limit.ts).
# CHAT_RATE_LIMIT_PER_MINUTE=15
# CHAT_RATE_LIMIT_PER_DAY=200

# --- Supabase (optional - enables user accounts, watchlist sync, alerts) ---
# Read at STATIC-SITE BUILD time by quartz/components/Head.tsx (`npx quartz
# build`, e.g. as Vercel project env vars) and baked into the page <meta> tags
# for the browser client (quartz/components/scripts/supabase-client.ts) to
# read. The anon key is a public, RLS-scoped key by design — safe to ship in
# HTML — but must still come from env, not be committed to source, so it can
# be rotated without a code change. If unset, watchlist/alerts/auth features
# degrade gracefully to localStorage-only (no sync across devices).
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
