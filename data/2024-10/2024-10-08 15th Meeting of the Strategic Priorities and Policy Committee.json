s:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira", "C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "ADDITIONAL VOTES:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by A. Hopkins", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to open the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira", "C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lehman", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Franke", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to close the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira", "C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2024-10-08 13:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=111881", "title": "2024-10-08 S