      "text": "for the provision of internal audit services"
    },
    {
      "index": 53,
      "start": "00:12:53.580",
      "end": "00:12:58.300",
      "text": "for a period of three years beginning on January 1st, 2022,"
    },
    {
      "index": 54,
      "start": "00:12:58.300",
      "end": "00:13:02.130",
      "text": "plus an option to renew for two additional one-year terms."
    },
    {
      "index": 55,
      "start": "00:13:02.130",
      "end": "00:13:05.090",
      "text": "Part B, civic administration be authorized"
    },
    {
      "index": 56,
      "start": "00:13:05.090",
