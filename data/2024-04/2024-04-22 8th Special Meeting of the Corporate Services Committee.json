        "1": {
          "title": "2024 Debenture Issuance Update",
          "number": "1",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "Moved by S. Stevenson",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "Seconded by C. Rahman",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That, on the recommendation of the Deputy City Manager, Finance Supports, the following actions be taken:\n\n\n\na) \u00a0 \u00a0the issuance of serial debentures for a total of $30,000,000 BE APPROVED, noting the average all-in rate is 4.427% over a 10-year term and that all debt has been placed with investors in the capital markets; and,",
                  "__class__": "Paragraph"
                },
                {
                  "string": "b) \u00a0 \u00a0the proposed by-law as appended to the staff report dated April 22, 2024 as Appendix \"A\" BE INTRODUCED at the Municipal Council meeting on April 23, 2024 to execute the borrowing upon serial debentures in the aggregate principal amount of $30,000,000 towards the cost of certain capital works of the Corporation of the City of London.",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [
                  {
                    "vote": "Yeas:",
                    "voters": [
                      "P. Van Meerbergen",
                      "P. Cuddy",
                      "S. Stevenson",
                      "C. Rahman"
                    ]
                  },
                  {
                    "vote": "Absent:",
                    "voters": [
                      "H. McAlister"
                    ]
                  }
                ],
                "__class__": "Vote"
              },
              "result": {
                "string": "Motion Passed (4 to 0)",
                "__class__": "MotionResult"
              },
