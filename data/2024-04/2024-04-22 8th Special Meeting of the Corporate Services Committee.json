{"title": "8th Special Meeting of the Corporate Services Committee", "datetime": "2024-04-22 13:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=0cbe4dc9-4321-442a-b5b3-b8a37a1c15e1&Agenda=PostMinutes&lang=English", "meeting_type": "Corporate Services Committee", "bills": null, "present": ["P. Cuddy", "S. Stevenson", "C. Rahman", "P. Van Meerbergen"], "also_present": ["A. Barbon", "K. Murray", "J. Paradis", "T. Pollitt", "E.Skalski", "J. Taylor."], "remote_attendance": ["S. Corman", "M. Galczynski", "E. Hunt."], "content": {"string": "The meeting is called to order at 1:00 PM; it being noted that Councillors S. Stevenson, C. Rahman, and P. Van Meerbergen were in remote attendance.", "__class__": "Paragraph"}, "absent": ["H. McAlister"], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {"1": {"title": "2024 Debenture Issuance Update", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Stevenson", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by C. Rahman", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Finance Supports, the following actions be taken:\n\n\n\na) \u00a0 \u00a0the issuance of serial debentures for a total of $30,000,000 BE APPROVED, noting the average all-in rate is 4.427% over a 10-year term and that all debt has been placed with investors in the capital markets; and,", "__class__": "Paragraph"}, {"string": "b) \u00a0 \u00a0the proposed by-law as appended to the staff report dated April 22, 2024 as Appendix \"A\" BE INTRODUCED at the Municipal Council meeting on April 23, 2024 to execute the borrowing upon serial debentures in the aggregate principal amount of $30,000,000 towards the cost of certain capital works of the Corporation of the City of London.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["P. Van Meerbergen", "P. Cuddy", "S. Stevenson", "C. Rahman"]}, {"vote": "Absent:", "voters": ["H. McAlister"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (4 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [{"empty_flag": false, "title": "2024-04-22 Staff Report - 2024 Debenture Issuance Update", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=107889", "date": "2024-04-22 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Confidential", "number": "6", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Adjournment", "number": "7", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Stevenson", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "That the meeting BE ADJOURNED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The meeting adjourned at 1:05 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2024-04-22 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}