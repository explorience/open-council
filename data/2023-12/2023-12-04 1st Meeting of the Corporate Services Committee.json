  "transcript": [
    {
      "index": 1,
      "start": "00:22:37.790",
      "end": "00:22:40.250",
      "text": "Okay, I'm going to call the first meeting"
    },
    {
      "index": 2,
      "start": "00:22:40.250",
      "end": "00:22:43.660",
      "text": "of the Corporate Service Committee to order 1201,"
    },
    {
      "index": 3,
      "start": "00:22:43.660",
      "end": "00:22:46.790",
      "text": "December 4th, 2023."
    },
    {
      "index": 4,
      "start": "00:22:46.790",
      "end": "00:22:49.050",
      "text": "The city of London is situated on the traditional lands"
    },
    {
      "index": 5,
      "start": "00:22:49.050",
      "end": "00:22:55.450",
      "text": "of the Anasheb Chabek, Haudenosaunee,"
    },
    {
      "index": 6,
      "start": "00:22:55.450",
      "end": "00:22:59.530",
      "text": "Lenny Payawak, and Adwondron."
    },
    {
      "index": 7,
      "start": "00:22:59.530",
      "end": "00:23:01.340",
      "text": "We honor and respect the history, languages,"
    },
    {
      "index": 8,
      "start": "00:23:01.340",
      "end": "00:23:03.260",
      "text": "and culture of the diverse indigenous people"
    },
    {
      "index": 9,
      "start": "00:23:03.260",
      "end": "00:23:05.100",
      "text": "who call this territory home."
    },
    {
      "index": 10,
      "start": "00:23:05.100",
      "end": "00:23:06.540",
      "text": "The city of London is currently home"
    },
    {
      "index": 11,
      "start": "00:23:06.540",
      "end": "00:23:09.300",
      "text": "to many First Nations, M\u00e9tis, and Inuit today."
    },
    {
      "index": 12,
      "start": "00:23:09.300",
      "end": "00:23:11.810",
      "text": "As representatives of the people of the city of London,"
    },
    {
      "index": 13,
      "start": "00:23:11.810",
      "end": "00:23:13.230",
      "text": "we are grateful to have the opportunity"
    },
    {
      "index": 14,
      "start": "00:23:13.230",
      "end": "00:23:15.770",
      "text": "to work and live in this territory."
    },
    {
      "index": 15,
      "start": "00:23:15.770",
      "end": "00:23:17.860",
      "text": "The city of London is committed to making every effort"
    },
    {
      "index": 16,
      "start": "00:23:17.860",
      "end": "00:23:20.650",
      "text": "to provide alternate formats and communication supports"
