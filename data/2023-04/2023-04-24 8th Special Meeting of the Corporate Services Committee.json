      "items": {
        "1": {
          "title": "2023 Debenture Issuance Update",
          "number": "1",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "Moved by S. Trosow",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "Seconded by S. Stevenson",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That, on the recommendation of the Deputy City Manager, Finance Supports, the following actions be taken with respect to the 2023 City of London Debenture Issuance:\n\n\n\na) \u00a0 \u00a0the issuance of serial debentures for a total of $21,500,000 BE APPROVED; it being noted that the average all-in rate is 3.881% over a 10-year term and that all debt has been placed with investors in the capital markets; and,",
                  "__class__": "Paragraph"
                },
                {
                  "string": "b) \u00a0 \u00a0the proposed by-law as appended to the staff report dated April 24, 2023 as Appendix \"A\" BE INTRODUCED at the Municipal Council meeting on April 25, 2023 to execute the borrowing upon serial debentures in the aggregate principal amount of $21,500,000 towards the cost of certain capital works of the Corporation of the City of London.",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [
                  {
                    "vote": "Yeas:",
                    "voters": [
                      "S. Lewis",
                      "H. McAlister",
                      "S. Stevenson",
                      "S. Trosow,D. Ferreira"
                    ]
                  },
                  {
                    "vote": "Absent:",
                    "voters": [
                      "Mayor J. Morgan"
                    ]
                  }
                ],
                "__class__": "Vote"
              },
              "result": {
                "string": "Motion Passed (5 to 0)",
                "__class__": "MotionResult"
              },
              "post_motion_texts": [],
              "__class__": "Motion"
            }
          ],
          "items": {},
          "datetime": "2023-04-24 12:00:00",
