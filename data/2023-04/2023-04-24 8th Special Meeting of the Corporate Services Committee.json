{"title": "8th Special Meeting of the Corporate Services Committee", "datetime": "2023-04-24 12:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=183fd70e-1a1c-4f11-a91a-3aa7675def79&Agenda=PostMinutes&lang=English", "meeting_type": "Corporate Services Committee", "bills": null, "present": ["S. Lewis", "H. McAlister", "S. Stevenson", "S. Trosow", "D. Ferreira"], "also_present": ["J. Pribil", "L. Livingstone", "A. Barbon", "M. Galczynski", "A. Job", "K. Murray", "B. Westlake-Power"], "remote_attendance": ["B. Card", "S. Corman"], "content": {"string": "The meeting is called to order at 12:00 PM.", "__class__": "Paragraph"}, "absent": ["J. Morgan"], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-04-24 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-04-24 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-04-24 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "2023 Debenture Issuance Update", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Trosow", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Finance Supports, the following actions be taken with respect to the 2023 City of London Debenture Issuance:\n\n\n\na) \u00a0 \u00a0the issuance of serial debentures for a tota