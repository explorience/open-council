{"title": "15th Meeting of the Planning and Environment Committee", "datetime": "2022-09-12 16:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=fe13c8aa-0b45-47e5-8e9c-7244c6467a51&Agenda=PostMinutes&lang=English", "meeting_type": "Planning and Environment Committee", "bills": null, "present": ["A. Hopkins", "S. Lewis", "S. Lehman", "S. Turner", "S. Hillier"], "also_present": ["A. Anderson", "H. Lysynski", "K. Van Lammeren"], "remote_attendance": ["G. Barrett", "J. Bunn", "M. Corby", "B. House", "J. Kelemen", "P. Kokkoros", "C. McCreery", "H. McNeely", "C. Parker", "M. Pease", "B. Westlake-Power"], "content": {"string": "The meeting was called to order at 4:01 PM, with Councillor A. Hopkins in the Chair, Councillors S. Lewis and S. Lehman present and all other members participating by remote attendance.", "__class__": "Paragraph"}, "absent": ["E. Holder"], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2022-09-12 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [], "items": {"1": {"title": "Building Division Monthly Report - July 2022", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Hillier", "__class__": "Mover"}, "motion_texts": [{"string": "That the Building Division Monthly report for July, 2022 BE RECEIVED for information. \u00a0(2022-A23)", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["A. Hopkins ", "S. Turner", "S. Lewis", "S. Hillier,S. Lehman"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2022-09-12 16:00:00", "attachments": [{"empty_flag": false, "title": "2022-09-12 Building Division Monthly Report - July 2022", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=94682", "date": "2022-09-12 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2022-09-12 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [], "items": {"1": {"title": "4680 Wellington Road South (TZ-9509)", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Hillier", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Director, Planning and Development, based on the application by 761030 Ontario Limited, relating to the property located at 4680 Wellington Road South, the proposed by-law appended to the staff report dated September 12, 2022 as Appendix 'A' BE INTRODUCED at the Municipal Council meeting to be held on September 27, 2022, to amend Zoning By-law Z.-1, (in conformity with the Official Plan), by extending the Temporary Use (T-74) Zone for a period not exceeding three (3) years;", "__class__": "Paragraph"}, {"string": "it being noted that no individuals spoke at the public participation meeting associated with this matter;", "__class__": "Paragraph"}, {"string": "it being further noted that the Municipal Council approves this application for the following reasons:", "__class__": "Paragraph"}, {"string": "- \u00a0 \u00a0the recommended amendment is consistent with the Provincial Policy Statement, 2020;\n\n- \u00a0 \u00a0the recommended amendment conforms to the in-force policies of The London Plan and the Future Industrial Growth Designation policies;\n\n- \u00a0 \u00a0the recommended amendment conforms to the in-force policies of the 1989 Official Plan and the Open Space Designation policies; and,\n\n- \u00a0 \u00a0the recommended temporary use provides an appropriate interim land use until such time as the subject lands and surrounding area develop for their intended landuses. The recommended use is not intended to continue on a permanent basis.\u00a0 (2022-D14)", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["A. Hopkins ", "S. Turner", "S. Lewis", "S. Hillier,S. Lehman"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional Votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lehman", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Hillier", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to open the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["A. Hopkins ", "S. Turner", "S. Lewis", "S. Hillier,S. Lehman"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Hillier", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Turner", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to close the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["A. Hopkins ", "S. Turner", "S. Lewis", "S. Hillier,S. Lehman"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2022-09-12 16:00:00", "attachments": [{"empty_flag": false, "title": "2022-09-12 Staff Report - 4680 Wellington Road South (TZ-9509)", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=94684", "date": "2022-09-12 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Public Participation Meeting - Not to be Heard before 4:00 PM - 1407-1427 Hyde Park Road (OZ-9438) ", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Turner", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "That the application by York Developments, relating to the properties located at 1407-1427 Hyde Park Road BE REFERRED back to the Civic Administration for further discussions with the applicant to address the outstanding concerns and to report back at a future meeting of the Planning and Environment Committee; it being noted that the referral is at the request of the applicant;", "__class__": "Paragraph"}, {"string": "it being noted that the Planning and Environment Committee received the staff presentation appended to the Added Agenda, with respect to these matters;", "__class__": "Paragraph"}, {"string": "it being pointed out that the following individual made a verbal presentation at the public participation meeting held in conjunction with this matter:", "__class__": "Paragraph"}, {"string": "- \u00a0 \u00a0S. Allen, MHBC Planning, on behalf of the applicant.\u00a0 \u00a0(2022-)", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["A. Hopkins ", "S. Turner", "S. Lewis", "S. Hillier,S. Lehman"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional Votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Turner", "__class__": "Mover"}, "seconded_by": {"strin