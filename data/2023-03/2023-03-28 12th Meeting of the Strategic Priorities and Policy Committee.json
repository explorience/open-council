{"title": "12th Meeting of the Strategic Priorities and Policy Committee", "datetime": "2023-03-28 16:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=c3e9c528-3e7f-490c-9de0-f83a0713cb9b&Agenda=PostMinutes&lang=English", "meeting_type": "Strategic Priorities and Policy Committee", "bills": null, "present": ["J. Morgan", "H. McAlister", "S. Lewis", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "C. Rahman", "S. Lehman", "A. Hopkins", "P. Van Meerbergen", "S. Franke", "E. Peloza", "D. Ferreira", "S. Hillier"], "also_present": ["L. Livingstone", "A. Barbon", "C. Cooper", "S. Corman", "C. Crossman", "T. Fowler", "A. Job", "S. Mathers", "R. Morris", "C. Smith", "M. Schulthess", "N. Steinburg", "J. Taylor", "R. Wilcox"], "remote_attendance": ["E. Bennett", "B. Card", "M. Goldrup", "S. Thompson"], "content": {"string": "The meeting is called to order at 4:02 PM, it being noted Councillors S. Hillier and P. Van Meerbergen were in remote attendance; it being further noted that Councillor E. Peloza was in remote attendance after 7:15 PM", "__class__": "Paragraph"}, "absent": [], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Trosow", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by C. Rahman", "__class__": "Mover"}, "motion_texts": [{"string": "That pursuant to section 27.6 of the Council Procedure by-law, the Committee BE PERMITTED to change the order of business to deal with Item 5.1 prior to Item 4.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2023-03-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "That Items 2.1 and 2.2, BE APPROVED", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {"1": {"title": "Music Incubation", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Planning and Economic Development, the report dated March 28, 2023, with respect to Music Incubation, the following actions be taken:", "__class__": "Paragraph"}, {"string": "a) \u00a0 \u00a0the above noted report BE RECEIVED;", "__class__": "Paragraph"}, {"string": "b) \u00a0 \u00a0the Civic Administration BE DIRECTED to develop a Creative Sector Incubator proposal; and,", "__class__": "Paragraph"}, {"string": "c) \u00a0 \u00a0the Civic Administration BE DIRECTED to continue discussions with provincial and federal decision-makers to explore investment opportunities.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2023-03-28 16:00:00", "attachments": [{"empty_flag": false, "title": "2023-03-28 Staff Report - Music Incubation", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=98291", "date": "2023-03-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "3rd Report of the Diversity, Inclusion and Anti-Oppression Community Advisory Committee", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "That the 3rd Report of the Diversity, Inclusion and Anti-Oppression Community Advisory Committee, from its meeting held on March 9, 2023 BE RECEIVED for information.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2023-03-28 16:00:00", "attachments": [{"empty_flag": false, "title": "2023-03-28 DIACAC Report", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=98289", "date": "2023-03-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2023-03-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-03-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "Council's Draft 2023-2027 Strategic Plan", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by H. McAlister", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Cuddy", "__class__": "Mover"}, "motion_texts": [{"string": "That, the following actions be take with respect to the Council\u2019s Draft 2023-2027 Strategic Plan:", "__class__": "Paragraph"}, {"string": "a) \u00a0 \u00a0the staff report dated March 28, 2023 entitled \u201cCouncil\u2019s Draft 2023-2027 Strategic Plan\u201d BE RECEIVED for information;", "__class__": "Paragraph"}, {"string": "b) \u00a0 \u00a0the attached revised \u201cCouncil\u2019s Draft Strategic Plan 2023-2027: Strategic Areas of Focus, Outcomes, Expected Results, Strategies and Metrics\u201d BE REFERRED to the April 17, 2023 meeting of Strategic Priorities and Policy Committee.", "__class__": "Paragraph"}, {"string": "it being noted that the Strategic Priorities and Policy Committee received a staff presentation and a communication dated March 24, 2023 from C. Butler with respect to this matter.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "P. Van Meerbergen", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["E. Peloza"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [{"string": "ADDITIONAL VOTES:", "__class__": "Paragraph"}], "moved_by": {"string": "Moved by H. McAlister", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Trosow", "__class__": "Mover"}, "motion_texts": [{"string": "That, the Strategic Area of Focus: Housing and Homelessness, Outcome 3, Expected Result 3.1, BE AMENDED in the 2023-2027 Strategic Plan, to add a new Draft Strategy e) \"apply the equity tool considering the people experiencing mobility poverty, consistent with The London Plan\".", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "E. Peloza", "H. McAlister", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Nays:", "voters": ["S. Lewis", "S. Hillier", "S. Lehman", "P. Cuddy,S. Stevenson"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (9 to 5)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Trosow", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by H. McAlister", "__class__": "Mover"}, "motion_texts": [{"string": "That the Committee recess at this time.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The Committee recesses at 6:04 PM and reconvenes at 6:39 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Cuddy", "__class__": "Mover"}, "motion_texts": [{"string": "That, the Strategic Area of Focus: Economic Growth, Culture and Prosperity, Outcome 4, Expected Result 4.3, Metric b) \"sq. ft of commercial space occupied vs vacant, ground level and upper floors, BE REMOVED from the 2023-2027 Strategic Plan\".", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "S. Lewis", "S. Hillier", "P. Van Meerbergen", "S. Lehman", "P. Cuddy,S. Stevenson"]}, {"vote": "Nays:", "voters": ["A. Hopkins", "H. McAlister", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["E. Peloza"]}], "__class__": "Vote"}, "result": {"string": "Motion Failed (7 to 7)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Trosow", "__class__": "Mover"}, "seconded_by"