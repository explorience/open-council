            "2": {
              "title": "(2.1) Next Generation 9-1-1 Transition Funding Support - Transfer Payment Agreements",
              "number": "2",
              "content": [
                {
                  "pre_motion_texts": [],
                  "moved_by": {
                    "string": "Motion made by E. Peloza",
                    "__class__": "Mover"
                  },
                  "seconded_by": {
                    "string": "",
                    "__class__": "Mover"
                  },
                  "motion_texts": [
                    {
                      "string": "That, on the recommendation of the Deputy City Manager, Neighbourhood and Community-Wide Services, the following actions be taken with respect to the staff report, dated March 21, 2023, related to the Next Generation 9-1-1 Transition Funding Support Transfer Payment Agreements:",
                      "__class__": "Paragraph"
                    },
                    {
                      "string": "a) \u00a0 \u00a0 the proposed by-law, as appended to the above-noted staff report, BE INTRODUCED at a special meeting of Municipal Council to be held on March 28, 2023, to:",
                      "__class__": "Paragraph"
                    },
                    {
                      "string": "i) \u00a0 \u00a0approve the Next Generation 9-1-1 Transition Funding Support Transfer Payment Agreement between His Majesty the King in right of Ontario, as represented by the Solicitor General, and The Corporation of the City of London (London Police Service-Communications Section), substantially in the form appended to the above-noted by-law;\n\nii) \u00a0 \u00a0delegate authority to the Deputy City Manager, Neighbourhood and Community-Wide Services to execute the above-noted Agreement;\u00a0\n\niii) \u00a0 \u00a0delegate authority to the Deputy City Manager, Neighbourhood and Community-Wide Services to approve and execute any further amending agreements to the above-noted Transfer Payment Agreement;\u00a0\n\niv) \u00a0 \u00a0authorize the Deputy City Manager, Neighbourhood and Community-Wide Services, or written delegate, to execute any financial reports required under the above-noted Agreement; and,\n\nv) \u00a0 \u00a0delegate authority to the Deputy City Manager, Neighbourhood and Community-Wide Services to approve and execute a future agreement between The Corporation of the City of London and the London Police Services Board assigning the terms of Schedule \u2018A\u2019 of Appendix \u2018A\u2019 to the London Police Services Board; and,",
                      "__class__": "Paragraph"
                    },
                    {
                      "string": "b) \u00a0 \u00a0the proposed by-law, as appended to the above-noted staff report, BE INTRODUCED at a special meeting of Municipal Council to be held on March 28, 2023, to;",
                      "__class__": "Paragraph"
                    },
                    {
                      "string": "i) \u00a0 \u00a0approve the Next Generation 9-1-1 Transition Funding Support Transfer Payment Agreement, between His Majesty the King in right of Ontario, as represented by the Solicitor General, and The Corporation of the City of London (London Fire Department-Communications Division), substantially in the form appended to the above-noted by-law;\n\nii) \u00a0 \u00a0delegate authority to the Deputy City Manager, Neighbourhood and Community-Wide Services to execute the above-noted Agreement; \u00a0\n\niii) \u00a0 \u00a0delegate authority to the Deputy City Manager, Neighbourhood and Community-Wide Services, or written designate, to undertake all the administrative, financial and reporting acts that are necessary in connection with the above-noted Agreement; and,\n\niv) \u00a0 \u00a0authorize the Deputy City Manager, Neighbourhood and Community-Wide Services, or written delegate, to execute any financial reports required under the above-noted Agreement.",
                      "__class__": "Paragraph"
                    }
                  ],
                  "vote": {
                    "rows": [],
                    "__class__": "Vote"
                  },
                  "result": {
                    "string": "Motion Passed",
                    "__class__": "MotionResult"
                  },
                  "post_motion_texts": [],
                  "__class__": "Motion"
