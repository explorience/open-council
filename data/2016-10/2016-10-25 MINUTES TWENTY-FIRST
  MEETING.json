 "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "V. Ridley", "H.L. Usher", "T. Park (12)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor P. Hubert", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Armstrong", "__class__": "Mover"}, "motion_texts": [{"string": "Approve clause 2 as amended.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "J. Morgan", "P. Hubert", "V. Ridley", "H.L. Usher", "T. Park (10)"]}, {"vote": "Nays:", "voters": ["M. Salih", "P. Squire (2)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VII": {"title": "MOTIONS OF\n  WHICH NOTICE IS GIVEN", "number": "VII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "_