        "1": {
          "title": "City of London Days at Budweiser Gardens - United Way Elgin and Middlesex ",
          "number": "1",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "Moved by P. Cuddy",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "Seconded by C. Rahman",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That, on the recommendation of the City Clerk and in accordance with Council\u2019s City of London Days at Budweiser Gardens Policy, the request from the United Way Elgin & Middlesex to host the annual Stairclimb on November 13, 2024, BE APPROVED as a City of London Day at Budweiser Gardens, notwithstanding Council\u2019s policy which restricts groups from having more than two event days over a consecutive five-year period.",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [],
