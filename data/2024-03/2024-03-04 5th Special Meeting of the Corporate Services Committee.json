{"title": "5th Special Meeting of the Corporate Services Committee", "datetime": "2024-03-04 13:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=ff8e4f45-e51a-4099-a1a8-1b671a90044b&Agenda=PostMinutes&lang=English", "meeting_type": "Corporate Services Committee", "bills": null, "present": ["H. McAlister", "P. Cuddy", "S. Stevenson", "C. Rahman", "P. Van Meerbergen", "J. Morgan"], "also_present": ["J. Pribil", "L. Livingstone", "A. Barbon", "I. Collins", "J. Kovacs", "J. Paradis", "T. Pollitt", "E. Skalski", "S. Swance", "J. Taylor."], "remote_attendance": ["S. Corman."], "content": {"string": "The meeting is called to order at 1:00 PM it being noted that Councillor P. Van Meerbergen was in remote attendance.", "__class__": "Paragraph"}, "absent": [], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2024-03-04 13:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Cuddy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That consent items 2.1 to 2.2 BE APPROVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor J. Morgan", "P. Van Meerbergen", "H. McAlister", "P. Cuddy", "S. Stevenson", "C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (6 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {"1": {"title": "Public Sector Salary Disclosure Act Report for Calendar Year 2023", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Cuddy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Finance Supports the report regarding the Public Sector Salary Disclosures Act, 1996, Report for Calendar Year 2023 BE RECEIVED for information.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2024-03-04 13:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=106927", "title": "2024-03-04 Staff Report - Public Sector Salary Disclosure", "date": "2024-03-04 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "2023 Statement of Remuneration and Expenses for Elected and Appointed Officials", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Cuddy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Finance Supports the following actions be taken:\n\n\n\na)\u00a0 \u00a0 in accordance with Section 284 of the Municipal Act, 2001, the Statements of Remuneration and Expenses for Elected and Appointed Officials, as appointed to the staff report dated March 4, 2024 as Appendix \u201cA\u201d and Appendix \u201cB\u201d, BE RECEIVED for information;\n\n\n\nb)\u00a0 \u00a0 in accordance with City Council resolution of March 2012, the annual report on the Mayor\u2019s Office\u2019s expenditures BE RECEIVED for information; and\n\n\n\nc)\u00a0 \u00a0 in accordance with City Council Travel and Business Expenses Policy, the Statement of Travel Expenses for Senior Administration Officials, as appended to the staff report dated March 4, 2024 as Appendix \u201cC\u201d and \u201cD\u201d, BE RECEIVED for information.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2024-03-04 13:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=106926", "title": "2024-03-04 Staff Report - 2023 Statement of Remuneration and Expenses", "date": "2024-03-04 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "3": {"title": "(ADDED) Government Relations Consulting Assignment", "number": "3", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Cuddy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the City Manager, in accordance with section 15.1 (c) of the Procurement of Goods and Services Policy, that Coriano Capital BE APPROVED to continue to provide consulting services for government relations, strategic advisory services, and advocacy in addressing local issues and advancing the city\u2019s interests at the federal, provincial, and local levels for a further two (2) months, which will extend their initial engagement till July 15, 2024.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor J. Morgan", "P. Van Meerbergen", "H. McAlister", "P. Cuddy", "S. Stevenson"]}, {"vote": "Nays:", "voters": ["C. Rahman"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 1)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2024-03-04 13:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=106928", "title": "2024-03-04 Staff Report - (2.3) Government Relations Consulting Assignment", "date": "2024-03-04 00:00:00", "local_page": null, "__class__": "At