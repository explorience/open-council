{"url": "https://pub-london.escribemeetings.com//Meeting.aspx?Id=1818236f-fc81-4b97-b839-e170bfdc8094&Agenda=PostMinutes&lang=English", "meeting_type": "Council", "bills": null, "present": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park", "J. Zaifman;", "C. Saunders"], "also_present": ["M. Hayward", "B. Card", "S. Corman", "S. Datars Bere", "S. Laforge", "M. Marcellin", "J. Raycraft", "M. Ribera", "L. Rowe", "J. Smout", "B. Westlake-Power"], "remote_attendance": [], "absent": ["M. Salih", "J. Zaifman"], "title": "MINUTES 14TH MEETING", "datetime": "2017-05-01 17:01:00", "content": [{"string": "The Council meets in Regular Session in the\n  Council Chambers this day at 5:01 PM.", "__class__": "Paragraph"}], "items": {"I": {"title": "DISCLOSURES\n  OF PECUNIARY INTEREST", "number": "I", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "II": {"title": "RECOGNITIONS", "number": "II", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "III": {"title": "REVIEW OF\n  CONFIDENTIAL MATTERS TO BE CONSIDERED IN PUBLIC", "number": "III", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IV": {"title": "COUNCIL, IN\n  CLOSED SESSION", "number": "IV", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "V": {"title": "CONFIRMATION\n  AND SIGNING OF THE MINUTES", "number": "V", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VI": {"title": "COMMUNICATIONS\n  AND PETITIONS", "number": "VI", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor H.L. Usher", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Armstrong", "__class__": "Mover"}, "motion_texts": [{"string": "Approve receipt and referral of the\n  following communication to be considered with the 16th Report of the\n  Corporate Services Committee:", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "1": {"title": "Ranked Ballot\n  Community Engagement Results Update", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion\nPassed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion\nPassed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VII": {"title": "MOTIONS OF\n  WHICH NOTICE IS GIVEN", "number": "VII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VIII": {"title": "REPORTS", "number": "VIII", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor T. Park", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor M. van Holst", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that pursuant to section 2.3\n  of the Council Procedure By-law, section 9.7 of said by-law be suspended to\n  permit a member to speak more than once to any motion with respect to the\n  ranked ballot model.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "16th Report of the\n  Corporate Services Committee\nCouncillor P. Hubert presents.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Ranked Ballot\n  Community Engagement Results", "number": "2", "content": [{"string": "That the following actions be taken with\n  respect to utilization of a ranked ballot model for the Municipal Election:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the attached presentation from\n  the City Clerk BE RECEIVED; and\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the following written\n  submissions BE RECEIVED:\ni)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  staff report dated April 22, 2017 regarding ranked ballot community\n  engagement results;\nii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  staff report dated January 24, 2017 regarding a ranked ballot election model\n  (resubmitted);\niii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 6, 2017, from J. Argall, speaking in support of\n  moving to a ranked ballot model;\niv)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 1, 2017, from D. Austin, speaking against moving to\n  a ranked ballot model;\nv)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 6, 2017, from L. Bartha, speaking against moving to\n  a ranked ballot model;\nvi)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication from C. Butler, speaking against moving to a ranked ballot\n  model;\nvii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication from dated March 1, 2017, from M. Campbell, speaking against\n  moving to a ranked ballot model;\nviii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated April 4, 2017, from S. Levin, speaking against moving to\n  a ranked ballot model;\nix)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 16, 2017, from M. McGuire, speaking in support of\n  moving to a ranked ballot model;\nx)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 9, 2017, from D. Schmidt, speaking against moving\n  to a ranked ballot model;\nxi)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated Mach 6, 2017, from F. Snyders, indicating the need for a\n  referendum on the question of whether or not to employ a ranked ballot model;\nxii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated April 3, 2017, from J. Cassar, speaking against a ranked\n  ballot model;\nxiii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated April 18, 2017, from R. Brawn, speaking against a ranked\n  ballot model;\nxiv)\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated April 13, 2017, from N.S. McIntyre, speaking in support\n  of a ranked ballot model;\nxv)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 22, 2017, from S. Barker, speaking against a ranked\n  ballot model;\nxvi)\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 19, 2017, from N. Bangsboll, speaking against a\n  ranked ballot model;\nxvii)\u00a0\u00a0\u00a0\u00a0 a\n  communication, from M. Chatwin, speaking in support of a ranked ballot model;\nxviii)\u00a0\u00a0\u00a0\u00a0 a\n  communication dated March 5, 2017, from B. Brock, providing data on voting\n  procedures and the importance of knowing and understanding \u201cthe people behind\n  the taking away your democratic right to vote or not to vote\u201d;\nxix)\u00a0\u00a0\u00a0\u00a0\u00a0 a\n  presentation by S. Lewkowitz and A. Sanchez, speaking in support of a ranked\n  ballot model;\n\u00a0\nit being pointed out that at the public\n  participation meeting associated with this matter, the individuals indicated\n  on the attached public participation meeting record made oral\n  submissions regarding this matter.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor T. Park", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that clause 2 be amended to add a\n  new part c), as follows:\n\u00a0\nc)\u00a0 \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the\n  City Clerk BE DIRECTED to bring forward a proposed by-law to be introduced at\n  the Municipal Council meeting to be held on May 1, 2017, for the purpose of\n  providing the necessary direction to implement a ranked ballot process for\n  the 2018 Municipal Election;", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"string": "Motion\nPassed", "__class__": "Paragraph"}, {"string": "Motion\nPassed", "__class__": "Paragraph"}, {"string": "Motion\nPassed", "__class__": "Paragraph"}, {"string": "Motion Passed", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "The motion to Approve the new part c) to\n  clause 2 is put. \n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "J. Helmer", "M. Cassidy", "J. Morgan", "V. Ridley", "S. Turner", "T. Park", "J. Zaifman (9)"]}, {"vote": "Nays:", "voters": ["B. Armstrong", "P. Squire", "P. Hubert", "A. Hopkins", "H.L. Usher (5)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor T. Park", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J. Helmer", "__class__": "Mover"}, "motion_texts": [{"string": "Approve clause 2, as amended.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "J. Helmer", "M. Cassidy", "J. Morgan", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park", "J. Zaifman (10)"]}, {"vote": "Nays:", "voters": ["B. Armstrong", "P. Squire", "P. Hubert", "A. Hopkins (4)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "1#2": {"title": "Disclosures of\n  Pecuniary Interest", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "That it BE NOTED that no pecuniary\n  interests were disclosed.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park", "J. Zaifman (14)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IX": {"title": "ADDED\n  REPORTS", "number": "IX", "content": [], "items": {}, "datetime": null, "attach