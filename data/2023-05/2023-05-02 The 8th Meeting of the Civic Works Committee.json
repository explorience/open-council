        "1": {
          "title": "(ADDED) Councillor S. Franke - Plastic Regulations Feedback",
          "number": "1",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "Moved by H. McAlister",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "Seconded by P. Cuddy",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That the following actions be taken with respect to the public consultation, released April 18, 2023, from the Environment and Climate Change Canada\u2019s \u201cStrategy on Zero Plastic Waste\u201d:",
                  "__class__": "Paragraph"
                },
                {
                  "string": "a)\u00a0 \u00a0 the Civic Administration BE DIRECTED to provide written feedback on the proposed plastic regulatory framework and technical document through the federal government process by the May 18, 2023 deadline;",
                  "__class__": "Paragraph"
                },
                {
                  "string": "b)\u00a0 \u00a0 the Civic Administration BE DIRECTED to provide a copy of the written submission to the Civic Works Committee at a future meeting; and,",
                  "__class__": "Paragraph"
                },
                {
                  "string": "c)\u00a0 \u00a0 the Civic Administration BE DIRECTED to provide a copy of the written submission to the Environmental Stewardship and Action Community Advisory Committee for information as part of ongoing discussions dealing with Blue Box transition in London. (2023-D22)",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [
                  {
                    "vote": "Yeas:",
                    "voters": [
                      "P. Van Meerbergen",
                      "H. McAlister",
                      "P. Cuddy",
                      "S. Trosow,C. Rahman"
                    ]
                  },
                  {
                    "vote": "Absent:",
                    "voters": [
                      "Mayor J. Morgan"
                    ]
                  }
                ],
                "__class__": "Vote"
              },
              "result": {
                "string": "Motion Passed (5 to 0)",
                "__class__": "MotionResult"
              },
              "post_motion_texts": [],
              "__class__": "Motion"
            }
