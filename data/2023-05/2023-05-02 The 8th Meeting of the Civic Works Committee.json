  "transcript": [
    {
      "index": 1,
      "start": "00:17:10.080",
      "end": "00:17:14.060",
      "text": "Audio check, Kirsten, are you able to hear me?"
    },
    {
      "index": 2,
      "start": "00:17:14.060",
