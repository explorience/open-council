        "2": {
          "title": "5th Report of the Integrated Transportation Community Advisory Committee",
          "number": "2",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That the following actions be taken with respect to the 5th\u00a0 Report of the Integrated Transportation Community Advisory Committee, from the meeting held on April 19, 2023:",
                  "__class__": "Paragraph"
                },
                {
                  "string": "a) the Civic Administration BE REQUESTED to make a presentation and provide statistics on the rate of vehicular accidents in the last 10 years within the City of London, including but not limited to:",
                  "__class__": "Paragraph"
                },
                {
                  "string": "i) all vision zero accidents;",
                  "__class__": "Paragraph"
                },
                {
                  "string": "ii) a breakdown of accident data based upon mode of transportation, which includes pedestrian accidents;",
                  "__class__": "Paragraph"
                },
                {
                  "string": "iii)\u00a0\u00a0\u00a0 comparable statistics to other cities that are similar size to the City of London (if available);",
                  "__class__": "Paragraph"
                },
                {
                  "string": "iv) number of fatalities per year related to vehicular accidents; and,",
                  "__class__": "Paragraph"
                },
                {
                  "string": "b) clauses 1.1, 3.1, 3.2 and 3.3 BE RECEIVED.",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [],
                "__class__": "Vote"
              },
              "result": {
                "string": "",
                "__class__": "MotionResult"
              },
              "post_motion_texts": [],
              "__class__": "Motion"
            }
          ],
