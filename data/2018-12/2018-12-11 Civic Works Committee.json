ote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2018-12-11 16:00:00", "attachments": [{"empty_flag": false, "title": "2018-11-27 TAC Report", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=55877", "date": "2018-11-27 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2018-12-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [], "items": {"1": {"title": "Application by - The Corporation of the City of London Street Renaming Portion of Third Street ( From Oxford Street East to Cheapside Street) To Baransway Drive", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Director, Development Services, the following actions be taken with respect to the renaming of the portion of Third Street (between Oxford Street East and Cheapside Street) to Baransway Drive:", "__class__": "Paragraph"}, {"string": "a)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the proposed by-law as appended to the staff report dated December 11, 2018\u00a0BE INTRODUCED at the Municipal Council Meeting to be held on December 18, 2018 to", "__class__": "Paragraph"}, {"string": "i)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 rename a portion of\u00a0Third Street between Oxford Street East and Cheapside Street,, to\u00a0Baransway Drive, effective February 1, 2019;", "__class__": "Paragraph"}, {"string": "b)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Trudell Medical\u00a0 Group BE REQUIRED to pay for all costs of street address change and the change of street signage; and,", "__class__": "Paragraph"}, {"string": "c)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Trudell Medical Group BE REQUIRED to compensate any property owner(s) for incurred costs associated with the municipal address change as a result of the street name change;", "__class__": "Paragraph"}, {"string": "it being\u00a0pointed out that at the public participation meeting associated with this matter, there were no oral submissions.\u00a0\u00a0(2018-D29)", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["P. Squire", "M. van Holst", "S. Lehman", "S. Lewis,E. Peloza"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional Votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lehman", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to open the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["P. Squire", "M. van Holst", "S. Lehman", "S. Lewis,E. Peloza"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by M. van Holst", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "Motion to close the public participation meeting.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["P. Squire", "M. van Holst", "S. Lehman", "S. Lewis,E. Peloza"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionR