{"url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=2fe4382f-afd4-4450-b834-6ce8c0b91e06&Agenda=PostMinutes&lang=English", "meeting_type": "Council", "bills": null, "present": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White", "C. Saunders"], "also_present": ["T. Dobbie", "S. Axford", "J.P. Barber", "G. Barrett", "J. Braam", "B. Coxhead", "E. Gamble", "M. Hayward", "G.T. Hopcroft", "J. Kobarda", "B. Krichker", "L. Livingstone", "A. Macpherson", "V. McAlea Major", "D. O\u2019Brien", "J. Ramsey", "L. Rowe", "R. Sharpe", "J. Taylor"], "remote_attendance": [], "absent": [], "title": "MINUTES 14TH MEETING", "datetime": "2012-07-24 17:00:00", "content": [{"string": "The Council meets in Regular Session in the\n  Council Chambers this day at 5:00 PM on July 24, 2012.", "__class__": "Paragraph"}], "items": {"I": {"title": "RECOGNITIONS", "number": "I", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "1": {"title": "Contract \u2013 Tim L.\n  Dobbie Ltd.", "number": "1", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Queen Elizabeth\n  Scholarships", "number": "2", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Update on 2011 Internal Audit of\n    Community Services \u2013 Housing Division", "number": "3", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "II": {"title": "DISCLOSURES\n  OF PECUNIARY INTEREST", "number": "II", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "III": {"title": "CONFIRMATION\n  AND SIGNING OF THE MINUTES OF THE THIRTEENTH MEETING HELD ON JUNE 26 and 27,\n  2012", "number": "III", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J.P. Bryant", "__class__": "Mover"}, "motion_texts": [{"string": "Approve the Minutes of the Thirteenth\n  Meeting held on June 26 and 27, 2012.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (15)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IV": {"title": "REVIEW\n  OF CONFIDENTIAL MATTERS TO BE CONSIDERED IN PUBLIC", "number": "IV", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "V": {"title": "COMMUNICATIONS\n  AND PETITIONS", "number": "V", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor N. Branscombe", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor P. Hubert", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Consideration with items,\n  identified as follows:", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Brownfield Administration Policy Project", "number": "4", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Engagement of PricewaterhouseCoopers for\n    Operational Review", "number": "5", "content": [{"string": "That, on the recommendation of the Deputy\n  City Treasurer, the following amendments to the Three-Year Internal Audit\n  Plan of PricewaterhouseCoopers, BE APPROVED:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the Health and Safety audit be\n  brought forward to 2012, from 2013;\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the Grants and Loans audit be\n  moved to 2013, from 2012.\u00a0 (2012-A04-00)", "__class__": "Paragraph"}, {"string": "That the following actions be taken with\n  respect to the 2011 Financial Audit and Audit Findings Report 2011, as\n  prepared by KPMG:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the 2011 Financial Report of The\n  Corporation of the City of London BE RECEIVED; \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 and,\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the Audit Findings Report for\n  the year ending December 31, 2011 BE RECEIVED; \n\u00a0\nit being noted that the Audit Committee\n  received the attached presentation from the Deputy City\n  Treasurer and a verbal presentation from KPMG with respect to these matters.\n  (2012-A04-00)", "__class__": "Paragraph"}, {"string": "That the following actions be taken with\n  respect to the Quarterly Report on Internal Audit Results, dated June 28,\n  2012, from PricewaterhouseCoopers:\n\u00a0\na) \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Community Services \u2013 Financial\n  Management \u2013 the Action Plans included as Appendix \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u2018A\u2019 of the\n  above-noted report BE IMPLEMENTED; it being noted that the \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 implementation\n  dates for some items are not applicable due to the cost of the \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 implementation\n  having been determined to be prohibitive to any potential benefit; and,\n\u00a0\nb) \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Planning, Environmental &\n  Engineering Services \u2013 Contract & Tendering \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Administration \u2013\n\u00a0\ni)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  the\n  Action Plans included as Appendix \u2018B\u2019 of the above-noted report BE\n  IMPLEMENTED; and,\nii)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  the\n  Interim City Manager BE DIRECTED to bring forward a report as soon as\n  possible with respect to a project approval process for tenders, with such\n  report to outline the practices and policies utilized by other\n  municipalities. (2012-A04-00)", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (15)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VI": {"title": "MOTIONS\n  OF WHICH NOTICE IS GIVEN", "number": "VI", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VII": {"title": "ADDED\n  REPORTS", "number": "VII", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor S. Orser", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor D. Brown", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that the following actions be taken with\n  respect to the 2013 Budget:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  the report of the\n  City Treasurer, Chief Financial Officer to the Strategic Priorities and\n  Policy Committee, dated June 25, 2012 and entitled \u201c2013-1017 Budget\n  Information Report\u201d, BE RECEIVED;\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  Civic Departments,\n  Boards, Commissions and outside agencies BE REQUESTED to table a\n  \u201cdraft\u201d 2013 budget with a target of 0.0% tax levy increase from 2012 rates;\n  it being noted that any significant service impacts associated with the above\n  be reviewed through a \u201cbusiness case\u201d approach and further that the Service\n  Review Committee be requested to review key \u201cbusiness cases\u201d that may have a\n  significant service impact to the community;\u00a0 and,\n\u00a0\nc)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  Civic\n  Departments, Boards, Commissions and outside agencies BE REQUESTED to identify\n  the costs of the extension of core services to new growth areas, it being\n  noted that financial policy on assessment growth was approved by Council on\n  May 22, 2012 for implementation; it being noted that the Strategic Priorities\n  and Policy Committee received a communication dated May 2, 2012, from G.\n  Macartney, CEO, London Chamber of Commerce, providing recommendations for the\n  City of London's budgetary processes, and a communication dated May 31, 2012\n  from L. E. Ducharme, General Manager, London Transit, regarding business plan\n  development and a multi-year budget program; it being further noted that the\n  City Treasurer, Chief Financial Officer gave the attached\n  presentation with respect to this matter;\u00a0\n\u00a0\nd)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  that Council set clear 2012 to 2017 budget targets\n  (long term) for the respective service areas, it being noted that several\n  boards; including the London Transit Commission, London Public Library,\n  Museum London, along with Civic Administration support long-term planning in\n  setting the financial framework for the municipality; it being noted that\n  this will allow service areas to adjust to Council set targets and allows the\n  community to absorb the changes.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D.G. Henderson", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor D. Brown", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that pursuant to section 11.14\n  of the Council Procedure By-law, that the question now be put.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "J.B. Swan", "S. Orser", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "S.E. White (8)"]}, {"vote": "Nays:", "voters": ["W.J. Armstrong", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "H.L. Usher", "J.P. Bryant (7)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "J.B. Swan", "S. Orser", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "S.E. White (8)"]}, {"vote": "Nays:", "voters": ["W.J. Armstrong", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "H.L. Usher", "J.P. Bryant (7)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor P. Hubert", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor S.E. White", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that pursuant to section 18.2 of\n  Council Procedure By-law leave be given for the introduction of emergent with\n  respect to a related motion to the 2013 Budget.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (14)"]}, {"vote": "Nays:", "voters": ["S. Orser (1)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor S.E. White", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor N. Branscombe", "__class__": "Mover"}, "motion_texts": [{"string": "Approve the acceptance of the attached\n  letter of resignation from Councillor N. Branscome from the of Services\n  Review Committee.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (15)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VIII": {"title": "REPORTS", "number": "VIII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Ontario Municipal Board Decision \u2013 1240\n  Richmond Street (Z-7949)", "number": "6", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Notice of Completion of Provincial\n  Environmental Assessment for Disposition of the London Psychiatric Hospital\n  Lands (O-7668)", "number": "7", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "8": {"title": "Meadowlily Secondary Plan \u2013 Status Report\n  (O-7614)", "number": "8", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "9": {"title": "Airport Area Tax Increment Grant Program \u2013\n  2480 Huron Street", "number": "9", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "10": {"title": "Telecommunication Facilities Consultation\n  Policy (O-7881)", "number": "10", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "11": {"title": "Properties located at 603, 609 and 611\n  Oxford Street West (Z-7578)", "number": "11", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "12": {"title": "Properties located at 981 and 983\n  Wonderland Road South (OZ-8043)", "number": "12", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "13": {"title": "Property located at 7 Greenfield Court", "number": "13", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "14": {"title": "Forest City Industrial Stormwater\n  Management Facility and Westminster Wetland Complex", "number": "14", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "15": {"title": "Property located at 1365 Dundas Street", "number": "15", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "16": {"title": "Properties located at 1197 York Street and\n  1201-1203 York Street (Z-8046)", "number": "16", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "17": {"title": "Bradley Avenue Underpass Tunnel", "number": "17", "content": [{"string": "That the Civic Administration BE REQUESTED\n  to review and report back to the Civic Works Committee with respect to the\n  cost of installing new lighting and/or increasing the wattage to the exiting\n  lighting in the Bradley Avenue underpass tunnel, and to also share their\n  findings with M. Fenton, 30-700 Exeter Road; it being noted that the CWC\n  heard a verbal delegation from Mr. Fenton, with respect to this matter.\n  (2012-C06-00)", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "18": {"title": "Sewer Back-Up - 25 Prince of Wales Gate", "number": "18", "content": [{"string": "That NO ACTION BE TAKEN with respect to a\n  request from J. Harkins, 25 Prince of Wales Gate to reverse a City sewer\n  backup charge of $5,000.00; it being noted that the Civic Works Committee\n  heard a verbal delegation from Mr. Harkins, with respect to this matter.\n  (2012-W10-00)", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "19": {"title": "Review of Policies and Practices for Major\n  City Projects", "number": "19", "content": [{"string": "That the communication dated June 25, 2012,\n  from Councillor B. Armstrong requesting a review of policies and practices\n  for major City projects BE RECEIVED; it being noted that the Civic\n  Administration carries out reviews and audits of major City projects on a\n  regular basis. (2012-G00-00)", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor J.B. Swan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Polhill", "__class__": "Mover"}, "motion_texts": [{"string": "Amend clause 16 by adding a new part c)\n  as follows:\n\u00a0\nc)\u00a0 \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the Civic Administration BE\n  DIRECTED to provide the Town and Gown Committee with \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 other\n  possible options to address the parking concerns relating to Roehampton \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Avenue.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (14)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "Councillor S. Orser enters the meeting at\n  8:29 PM.", "__class__": "Paragraph"}, {"string": "Pursuant to section 17.2 of the Council\n  Procedure By-law, Councillor D. Brown calls for a separate vote on clause 15.\n\u00a0\nPursuant to section 17.2 of the Council\n  Procedure By-law, Councillor M. Brown calls for a separate vote on clause 18.", "__class__": "Paragraph"}, {"string": "Motion to Approve Clause 15 is put.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J.F. Fontana", "B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "N. Branscombe", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "H.L. Usher", "J.P. Bryant", "S.E. White (14) RECUSED: D. Brown (1)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "Motion to Approve Clause 18 is put.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"st