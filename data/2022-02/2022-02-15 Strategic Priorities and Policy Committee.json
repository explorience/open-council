                      "E. Peloza",
                      "P. Van Meerbergen",
                      "S. Lehman",
                      "Mayor E. Holder",
                      "J. Fyfe-Millar,M. Hamou"
                    ]
                  }
                ],
                "__class__": "Vote"
              },
              "result": {
                "string": "Motion Passed (15 to 0)",
                "__class__": "MotionResult"
              },
              "post_motion_texts": [],
              "__class__": "Motion"
            }
