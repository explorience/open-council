{"title": "15th Special Meeting of the Community and Protective Services Committee", "datetime": "2025-10-08 14:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=0e618bea-891f-4c4f-a8e3-fe1fec6135b0&Agenda=PostMinutes&lang=English", "meeting_type": "Community and Protective Services Committee", "bills": null, "present": ["D. Ferreira", "H. McAlister", "P. Cuddy", "J. Pribil", "S. Trosow", "J. Morgan"], "also_present": ["Deputy  S. Lewis", "A. Hopkins", "S. Hillier", "S. Datars Bere", "V. Arora", "B. Baar", "A. Barbon", "I. Collins", "C. Cooper", "K. Dickins", "D. Escobar", "M. Feldberg", "P. Ladouceur", "S. Mathers", "K. Murray", "J. Paradis", "M. Pease", "T. Pollitt", "A. Rammeloo", "K. Scherr", "E. Skalski", "C. Smith", "J. Bunn"], "remote_attendance": ["S. Stevenson", "C. Rahman", "S. Franke", "E. Peloza", "S. Corman", "A. Pfeffer"], "content": {"string": "The meeting was called to order at 2:01 PM.", "__class__": "Paragraph"}, "absent": [], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2025-10-08 14:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2025-10-08 14:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2025-10-08 14:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "Micro-Modular Shelter Site", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Mayor J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by H. McAlister", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the City Manager, the following actions be taken with respect to the staff report dated October 8, 2025 related to a Micro-Modular Shelter Site:", "__class__": "Paragraph"}, {"string": "a) \u00a0 \u00a0the Micro-Modular Shelter Site implementation plan as described in this report BE ENDORSED;", "__class__": "Paragraph"}, {"string": "b) \u00a0 \u00a0the Civic Administration BE AUTHORIZED to finalize 1710 Wilton Grove Road as the location for an up to 2-year temporary Micro-Modular Shelter Site subject to obtaining required permits and approvals;", "__class__": "Paragraph"}, {"string": "c) \u00a0 \u00a0the Civic Administration BE AUTHORIZED to undertake procurement for all structures and services required to implement the Micro-Modular Shelter Site;", "__class__": "Paragraph"}, {"string": "d) \u00a0 \u00a0funding for the costs of the Micro-Modular Shelter Site through April 2027 BE APPROVED from the Operating Budget Contingency Reserve;", "__class__": "Paragraph"}, {"string": "e) \u00a0 \u00a0the Civic Administration BE AUTHORIZED to undertake all the administrative acts that are necessary in connection with this project;", "__class__": "Paragraph"}, {"string": "f) \u00a0 \u00a0the approvals given, herein, BE CONDITIONAL upon the Corporation entering into all necessary agreements and contracts noting that Civic Administration will report back to Council on the outcome of the negotiated agreements and formal contract awards;", "__class__": "Paragraph"}, {"string": "g) \u00a0 \u00a0the Mayor and the City Clerk BE AUTHORIZED to execute any contract or other documents, if required, to give effect to these recommendations; and,", "__class__": "Paragraph"}, {"string": "h) \u00a0 \u00a0the Civic Administration BE DIRECTED to report back to Council upon the start of operation of the Micro-Modular Shelter Site and to provide an update after one year of operation of the site.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional Votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Mayor J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by H. McAlister", "__class__": "Mover"}, "motion_texts": [{"string": "That part b) of the motion BE APPROVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor J. Morgan", "H. McAlister", "P. Cuddy", "J. Pribil", "D. Ferreira"]}, {"vote": "Nays:", "voters": ["S. Trosow"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 1)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Mayor J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by H. McAlister", "__class__": "Mover"}, "motion_texts": [{"string": "That the remainder of the motion BE APPROVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor J. Morgan", "H. McAlister", "P. Cuddy", "J. Pribil", "S. Trosow", "D. Ferreira"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (6 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2025-10-08 14:00:00", "attachments": [{"empty_flag": false, "title": "2025-10-08 SR Micro-Modular Shelter Site - Cover", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=119275", "date": "2025-10-08 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2025-10-08 14:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "dateti