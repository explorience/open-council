er"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "That Councillor J. Morgan BE APPOINTED as the Council lead for the 2019 Budget process, acting as Budget Chair with duties including coordination of 2019 Budget activities with the Civic Administration and the Chairing of the Strategic Priorities and Policy Committee meetings where discussion and consideration of the adoption of the 2019 Budget takes place.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor E. Holder", "M. van Holst", "S. Lewis", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "S. Lehman", "A. Hopkins", "P. Van Meerbergen", "S. Turner", "E. Peloza", "A. Kayabaga", "S. Hillier"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2019-01-14 16:00:00", "attachments": [{"empty_flag": false, "title": "2019-01-14 Submission - 2019 Budget Process", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=56695", "date": "2019-01-14 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2019-01-14 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2019-01-14 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Confidential (Enclosed for Members only.)", "number": "6", "content": [], "items": {"1": {"title": "ADDED - Land Disposition/Solicitor-Client Privileged Advice/Commercial or Financial Information Belonging to the City", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Helmer", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "That the Strategic Priorities and Policy Committee convene In Closed Session at 6:04 PM, for consideration of the following matter:", "__class__": "Paragraph"}, {"string": "6.1\u00a0\u00a0\u00a0\u00a0 ADDED - Land Disposition/Solicitor-Client Privileged Advice/Commercial or Financial Information Belonging to the City of London", "__class__": "Paragraph"}, {"string": "A matter pertaining to the proposed or pending disposition of land by the municipality, including communications necessary for that purpose; advice that is subject to solicitor-client privilege; commercial and financial information, that belongs to the municipality and has monetary value or potential monetary value and a position, plan, procedure, criteria or instruction to be applied to any negotiations carried on or to be carried on by or on behalf of the municipality.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["Mayor E. Holder", "M. van Holst", "S. Lewis", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "S. Lehman", "A. Hopkins", "P. Van Meerbergen", "S. Turner", "E. Peloza", "A. Kayabaga", "S. Hillier"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The Strategic Priorities and Policy Committee convened In Closed Session from 6:04 PM to 6:44 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2019-01-14 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2019-01-14 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Adjournment", "number": "7", "content": [{"string": "The meeting adjourned at 6:44 PM.", "__class__": "Paragraph"}], "items": {}, "datetime": "2019-01-14 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}