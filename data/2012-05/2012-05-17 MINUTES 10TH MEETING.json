 Committee of the Whole\nCouncillor M. Brown presents", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor M. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor H.L. Usher", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that leave be given for the\n  making of a substantive motion as it relates to the 9th Report of the\n  Committee of the Whole.\n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by H.L. Usher", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S.E.\n  White", "__class__": "Mover"}, "motion_texts": [{"string": "Approve clause 1.\n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "X": {"title": "BY-LAWS", "number": "X", "content": [{"string": "BY-LAWS TO BE READ A FIRST, SECOND AND\n  THIRD TIME:", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P.\n  Hubert", "__class__": "Mover"}, "motion_texts": [{"string": "Approve 1st reading of Bill No.\u2019s 218 and 244.\n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by D. Henderson", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by D. Brown", "__class__": "Mover"}, "motion_texts": [{"string": "Approve 2nd reading of Bill No.\u2019s 218 and 244.\n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by H.L. Usher", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J.L.\n  Baechler", "__class__": "Mover"}, "motion_texts": [{"string": "Approve 3rd reading of Bill No.\u2019s 218 and 244.\n\u00a0\nMotion Passed", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "The following by-laws are passed and\n  enacted as by-laws of The Corporation of the City of London:", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XII": {"title": "ADJOURNMENT", "number": "XII", "content": [{"string": "Motion Passed", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "WordMeeting"}