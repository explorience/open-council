{"url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=94dd8dce-987e-40b1-9ddf-88c76ca1c987&Agenda=PostMinutes&lang=English", "meeting_type": "Council", "bills": null, "present": ["J. Baechler", "B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White", "C. Saunders"], "also_present": ["A. Zuidema", "J.P. Barber", "G.T. Hopcroft", "V. McAlea Major", "R. Paynter", "J. Purser", "M. Ribera", "L.M. Rowe", "J. Smout", "B. Westlake-Power"], "remote_attendance": [], "absent": ["N. Branscombe"], "title": "MINUTES 18TH MEETING", "datetime": "2014-06-25 13:07:00", "content": [{"string": "The Council meets in Special Session in the\n  Council Chambers this day at 1:07 PM.", "__class__": "Paragraph"}], "items": {"I": {"title": "DISCLOSURES\n  OF PECUNIARY INTEREST", "number": "I", "content": [{"string": "No pecuniary interests are disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "II": {"title": "REVIEW OF\n  CONFIDENTIAL MATTERS TO BE CONSIDERED IN PUBLIC", "number": "II", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "III": {"title": "ADDED\n  REPORTS", "number": "III", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IV": {"title": "RECOGNITIONS", "number": "IV", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "V": {"title": "CONFIRMATION\n  AND SIGNING OF THE MINUTES OF THE SEVENTEENTH MEETING HELD ON JUNE 24, 2014", "number": "V", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor P. Hubert", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J.B. Swan", "__class__": "Mover"}, "motion_texts": [{"string": "Approve the Minutes of the 17th Meeting\n  held on June 24, 2014.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VI": {"title": "COMMUNICATIONS\n  AND PETITIONS", "number": "VI", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "1": {"title": "Resolution from the\n  Special Council Meeting of June 24, 2014 with respect to the filling of the\n  vacancy of a Ward seat.", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor J.P. Bryant", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Armstrong", "__class__": "Mover"}, "motion_texts": [{"string": "Approve the receipt of the communication\n  from the City Clerk, dated June 25, 2014, outlining the following with\n  respect to the filling of the Ward 5 seat vacancy:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\n  Council Members each BE INVITED to bring forward a nomination to fill the\n  vacant Ward 5 Councillor position, to the special Council meeting scheduled\n  for 1 PM, June 25, 2014; it being noted that any such nominated person must\n  attend the City Clerk\u2019s Office prior to 11 AM, on June 25, 2014, in order to\n  confirm their eligibility and be certified as an eligible candidate; and.\n\u00a0\n\u00a0\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\n  \u00a0\u00a0the City Clerk BE DIRECTED to bring forward, to the June 25, 2014 Council\n  meeting, a process for filling the vacancy which incorporates b) above, into\n  a similar nomination process as was followed for the filling of the vacancy\n  in the Office of the Mayor.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VII": {"title": "MOTIONS OF\n  WHICH NOTICE IS GIVEN", "number": "VII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VIII": {"title": "REPORTS", "number": "VIII", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor H.L. Usher", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that the following\n  actions be taken with respect to filling the vacancy in the office of Ward 5\n  Councillor: \n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  the\n  attached procedure for filling the vacancy in the office of Ward 5\n  Councillor, which \u00a0\u00a0\u00a0reflects the direction of the Municipal Council from its\n  special meeting held on June 24, 2014, BE APPROVED; and,\n\u00a0\nb)\u00a0\u00a0\n  \u00a0\u00a0\u00a0\u00a0\u00a0 subject to the selection of an individual to fill the vacancy in the\n  office of Ward 5 Councillor, the City Clerk BE DIRECTED to prepare the\n  appropriate by-law for introduction and enactment by the Municipal Council,\n  at the earliest possible date, to appoint the successful nominee to the Ward\n  5 seat.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that the slate of nominees\n  for appointment to the office of Councillor for Ward 5, BE COMPRISED of the\n  following nominees:\n\u00a0\nHamou, Mariam\nMonteith, Russell\nWilliams, Garth", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor J.B. Swan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Polhill", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that Russell Monteith, having\n  received a majority of votes, BE APPOINTED to the office of Councillor for\n  Ward 5\u00a0 for the City of London for a term commencing on June 25, 2014 and\n  ending on November 30, 2014, pursuant to section 260(1) of the Municipal Act,\n  2001; it being noted that the slate of nominees received the following votes:\u00a0\n  Nominee Hamou, Mariam, 1 vote; Nominee Monteith, Russell, 11 votes; and\n  Nominee Williams, Garth, 1 vote.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IX": {"title": "DEFERRED\n  MATTERS", "number": "IX", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "X": {"title": "ENQUIRIES", "number": "X", "content": [{"string": "Councillor Usher enquired how the recent\n  appointments to the Office of the Mayor and the office of Ward 5 Councillor\n  will impact current appointments to Standing Committees and Boards and\n  Commissions.\u00a0 The Chair advised that these matters would be considered at the\n  next meeting of the Strategic Priorities and Policy Committee.", "__class__": "Paragraph"}, {"string": "Councillor D. Brown enquired who would be\n  attending the upcoming meetings of the Boards and Commissions until such time\n  as the Strategic Priorities and Policy Committee has considered the\n  appointments that are currently filled by Mayor Baechler and Municipal\n  Council has confirmed the appointments.\u00a0 The Chair indicated that she would\n  continue to attend meetings until such time as the appointments have been\n  considered by the Strategic Priorities and Policy Committee and confirmed by\n  Municipal Council.", "__class__": "Paragraph"}, {"string": "Councillor S.E. White enquired as to the\n  process that would be undertaken to inform the nominees for the Ward 5\n  vacancy as to the decision of Municipal Council with respect to the matter.\u00a0\n  The Chair requested that the City Clerk inform the nominees and forward a\n  letter of thanks to each of the nominees for their interest in letting their\n  name stand for nomination.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XI": {"title": "EMERGENT\n  MOTIONS", "number": "XI", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XII": {"title": "BY-LAWS", "number": "XII", "content": [{"string": "BY-LAWS TO BE READ A FIRST, SECOND AND\n  THIRD TIME:", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor B. Polhill", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J.P. Bryant", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Introduction and First Reading\n  of Bill No. 336 and Bill No. 337.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor B. Polhill", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J.P. Bryant", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Second Reading of Bill No. 336\n  and Bill No. 337.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor B. Polhill", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Third Reading and\n  Enactment of Bill No. 336 and Bill No. 337.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "P. Van Meerbergen", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XIII": {"title": "ADJOURNMENT", "number": "XIII", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor B. Polhill", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor B. Armstrong", "__class__": "Mover"}, "motion_texts": [{"string": "Approve adjournment.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}