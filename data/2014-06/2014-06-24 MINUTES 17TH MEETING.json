{"url": "https://pub-london.escribemeetings.com//Meeting.aspx?Id=296bf116-08e6-4aec-ac1b-935d0b1bb4c9&Agenda=PostMinutes&lang=English", "meeting_type": "Council", "bills": null, "present": ["B. Polhill", "W.J. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White", "C. Saunders"], "also_present": ["A. Zuidema", "J.P. Barber", "G.T. Hopcroft", "R. Paynter", "M. Ribera", "L.M. Rowe", "J. Smout", "B. Westlake-Power"], "remote_attendance": [], "absent": ["N. Branscombe", "P. Van Meerbergen"], "title": "MINUTES 17TH MEETING", "datetime": "2014-06-24 20:00:00", "content": [{"string": "The Council meets in Special Session in the\n  Council Chambers this day at 8:00 PM.", "__class__": "Paragraph"}], "items": {"I": {"title": "DISCLOSURES\n  OF PECUNIARY INTEREST", "number": "I", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "II": {"title": "REVIEW OF\n  CONFIDENTIAL MATTERS TO BE CONSIDERED IN PUBLIC", "number": "II", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "III": {"title": "ADDED\n  REPORTS", "number": "III", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IV": {"title": "RECOGNITIONS", "number": "IV", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "V": {"title": "COMMUNICATIONS\n  AND PETITIONS", "number": "V", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "1": {"title": "Resolution from the\n  Council Meeting of June 24, 2014 with respect to the declaration of a\n  potential vacancy of a Ward seat.", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor B. Polhill", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor D. Brown", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that:\n\u00a0\nWHEREAS by Bill No. 335, Joni Baechler,\n  Councillor Ward 5, was appointed to the office of Mayor pursuant to section\n  263(1) of the Municipal Act, 2001;\n\u00a0\nAND WHEREAS section 259(1)(e) of the\n  Municipal Act, 2001 provides that the office of a member of council of a\n  municipality becomes vacant if the member is appointed or elected to fill any\n  vacancy in any other office on the same council;\n\u00a0\nBE IT HEREBY RESOLVED THAT:\nThe office of Councillor Ward 5 BE DECLARED\n  vacant in accordance with section 262 of the Municipal Act, 2001, c.25.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "M. Brown", "P. Hubert", "D.G. Henderson", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (11)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D.G. Henderson", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor S.E. White", "__class__": "Mover"}, "motion_texts": [{"string": "Approve the deferral of\n  consideration of an appointment to the Ward 5 vacancy for a period of approximately\n  3 weeks, until the next regular meeting cycle of Council", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["D.G. Henderson", "J.P. Bryant", "S.E. White (3)"]}, {"vote": "Nays:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "J.L. Baechler", "M. Brown", "P. Hubert", "D. Brown", "H.L. Usher (9)"]}], "__class__": "Vote"}, "result": {"string": "Motion Failed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor S. Orser", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that the following actions be\n  taken with respect to the filling of the Ward 5 vacancy:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  Council\n  Members each BE INVITED to bring forward a nomination to fill the vacant Ward\n  5 Councillor position, to the special Council meeting scheduled for 1 PM,\n  June 25, 2014; it being noted that any such nominated person must attend the\n  City Clerk's Office prior to 11 AM, on June 25, 2014, in order to confirm\n  their eligibility and be certified as an eligible candidate; and,\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\n  the\n  City Clerk BE DIRECTED to bring forward, to the June 25, 2014 Council meeting,\n  a process for filling the vacancy which incorporates a) above, into a similar\n  nomination process as was followed for the filling of the vacancy in the\n  Office of Mayor.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "B. Armstrong", "J.B. Swan", "S. Orser", "M. Brown", "P. Hubert", "D.G. Henderson", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (11)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor H.L. Usher", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor J.P. Bryant", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that further to the invitation\n  for nominations, any potential nominees BE REQUESTED to attend the City\n  Clerk's office prior to 11 AM June 25th, 2014 for certification of\n  eligibility.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "J.B. Swan", "S. Orser", "J.L. Baechler", "M. Brown", "P. Hubert", "D.G. Henderson", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (11)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VI": {"title": "MOTIONS OF\n  WHICH NOTICE IS GIVEN", "number": "VI", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VII": {"title": "REPORTS", "number": "VII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "VIII": {"title": "DEFERRED\n  MATTERS", "number": "VIII", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "IX": {"title": "ENQUIRIES", "number": "IX", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "X": {"title": "EMERGENT\n  MOTIONS", "number": "X", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XI": {"title": "BY-LAWS", "number": "XI", "content": [{"string": "BY-LAWS TO BE READ A FIRST, SECOND AND\n  THIRD TIME:", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D. Brown", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor H.L. Usher", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Introduction and First Reading\n  of Bill No. 334.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["B. Polhill", "J.B. Swan", "S. Orser", "M. Brown", "P. Hubert", "D.G. Henderson", "D. Brown", "H.L. Usher", "J.P. Bryant", "S.E. White (10) RECUSED: J.L. Baechler (1)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor D. Brown", "__c