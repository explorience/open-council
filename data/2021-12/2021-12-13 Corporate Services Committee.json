rt", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Cassidy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J. Fyfe-Millar", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Director, Anti-Racism and Anti-Oppression, and the concurrence of the City Manager, the staff report dated December 13, 2021 regarding the 2021 Accessibility Compliance Report BE RECEIVED for information purposes.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Cassidy", "J. Morgan", "S. Lewis", "E. Holder", "J. Fyfe-Millar", "M. Hamou"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (6 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-12-13 12:00:00", "attachments": [{"empty_flag": false, "title": "2021-12-13 Staff Report - 2021 Accessibility Compliance Report", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=88596", "date": "2021-12-13 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2021-12-13 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Confidential (Enclosed for Members only.)", "number": "6", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Fyfe-Millar", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Holder", "__class__": "Mover"}, "motion_texts": [{"string": "That the Corporate Services Committee convene, In Closed Session, with respect to the following matter:\n\n\n\n6.1 \u00a0 \u00a0 Land Acquisition / Solicitor-Client Privileged Advice / Position, Plan, Procedure, Criteria or Instruction to be Applied to Any Negotiations \n\n\u00a0 \u00a0 \u00a0 \u00a0\n\nA matter pertaining to the proposed or pending acquisition of land by the municipality, including communications necessary for that purpose; advice that is subject to solicitor-client privilege; commercial and financial information, that belongs to the municipality and has monetary value or potential monetary value and a position, plan, procedure, criteria or instruction to be applied to any negotiations carried on or to be carried on by or on behalf of the municipality.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Cassidy", "J. Morgan", "S. Lewis", "E. Holder", "J. Fyfe-Millar", "M. Hamou"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (6 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The Corporate Services Committee convenes, In Closed Session, from 12:35 PM to 12:45 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2021-12-13 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Adjournment", "number": "7", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Fyfe-Millar", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by M. Hamou", "__class__": "Mover"}, "motion_texts": [{"string": "That the meeting BE ADJOURNED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The meeting adjourned at 12:47 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2021-12-13 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}