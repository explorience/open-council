{"title": "7th Meeting of the Strategic Priorities and Policy Committee - Special Meeting", "datetime": "2023-01-23 16:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=4812aa40-07f0-4604-a9d6-d19904166de1&Agenda=PostMinutes&lang=English", "meeting_type": "Strategic Priorities and Policy Committee", "bills": null, "present": ["J. Morgan", "H. McAlister", "S. Lewis", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "C. Rahman", "S. Lehman", "A. Hopkins", "P. Van Meerbergen", "S. Franke", "E. Peloza", "D. Ferreira", "S. Hillier"], "also_present": ["L. Livingstone", "A. Barbon", "C. Cooper", "S. Corman", "S. Mathers", "K. Scherr", "M. Schulthess", "C. Smith", "N. Steinberg", "K. Van Lammeren", "B. Westlake-Power", "R. Wilcox"], "remote_attendance": ["B. Card"], "content": {"string": "The meeting is called to order at 4:03 PM, it being noted that Councillors P. Van Meerbergen, D. Ferreira and S. Hillier were in remote attendance; it being further noted that Councillor S. Franke was in remote attendance after 8:00 PM.", "__class__": "Paragraph"}, "absent": [], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "Developing the 2023-2027 Strategic Plan: Setting the Strategic Areas of Focus, Outcomes and Expected Results", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lehman", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the City Manager, the following actions be taken with respect to developing the 2023-2027 Strategic Plan:\n\n\n\na) \u00a0 \u00a0the report, entitled \u201cDeveloping the 2023-2027 Strategic Plan: Strategic Areas of Focus, Outcomes, and Expected Results\u201d BE RECEIVED for information; and,\n\n\n\nb) \u00a0 \u00a0the  draft strategic areas of focus, outcomes, and expected results for the 2023-2027 Strategic Plan, excluding the Wellbeing and Safety strategic area of focus,\u00a0 BE CONSIDERED and BE SHARED with the community to seek feedback;", "__class__": "Paragraph"}, {"string": "it being noted that the Strategic Priorities and Policy Committee received a staff presentation with respect to this matter.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional Votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by A. Hopkins", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Franke", "__class__": "Mover"}, "motion_texts": [{"string": "That the SPPC recess at this time.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The SPPC recesses at 6:05 PM; the SPPC reconvenes at 6:42 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That pursuant to section 33.8 of the Council Procedure by-law, the Committee BE PERMITTED to proceed beyond 11:00 PM.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "That the draft \"Wellbeing and Safety\" strategic focus BE AMENDED in Outcome 1, Expected Results, part e) by removing the words \"noise reduction\".", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil,C. Rahman"]}, {"vote": "Nays:", "voters": ["A. Hopkins", "S. Trosow", "S. Franke,D. Ferreira"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (10 to 4)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by C. Rahman", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Cuddy", "__class__": "Mover"}, "motion_texts": [{"string": "That the draft strategic area of focus, Wellbeing and Safety, including draft outcomes and expected results, BE CONSIDERED and BE SHARED with the community to seek feedback., excluding part e) of Expected Results.", "__class__": "Paragraph"}, {"string": "London has safe, vibrant, and healthy neighbourhoods and communities.", "__class__": "Paragraph"}, {"string": "Expected Results:", "__class__": "Paragraph"}, {"string": "- Londoners feel safe across the city, in the core, and in their neighbourhoods and communities.", "__class__": "Paragraph"}, {"string": "- Londoners have a strong sense of belonging and sense of place.", "__class__": "Paragraph"}, {"string": "- Londoners have safe access to public spaces, services, and supports that increase their wellbeing and quality of life.", "__class__": "Paragraph"}, {"string": "- Improved emergency services response time and reporting", "__class__": "Paragraph"}, {"string": "-", "__class__": "Paragraph"}, {"string": "- Improved park maintenance and garbage collection", "__class__": "Paragraph"}, {"string": "- Improved boulevard and bus shelter maintenance and garbage collection", "__class__": "Paragraph"}, {"string": "- Improved wayfinding and walkability", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Trosow", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "That the draft \"Wellbeing and Safety\" strategic focus Outcome 1, Expected Results, part e) of Outcome 1, BE APPROVED.", "__class__": "Paragraph"}, {"string": "e)\u00a0 Improved traffic safety, traffic calming", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "H. McAlister", "P. Cuddy", "S. Stevenson", "J. Pribil", "S. Franke", "D. Ferreira,C. Rahman"]}, {"vote": "Nays:", "voters": ["S. Trosow"]}, {"vote": "Absent:", "voters": ["P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (13 to 1)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2023-01-23 16:00:00", "attachments": [{"empty_flag": false, "title": "2023-01-23  Developing the 2023-2027 Strategic Plan final", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=97019", "date": "2023-01-23 00:00:00", "local_page": null, "__class__": "Attachment"}, {"empty_flag": false, "title": "2023-01-23 Appendices - Areas of Focus, Outcomes, and Expected Results final", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=97020", "date": "2023-01-23 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Adjournment", "number": "6", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by H. McAlister", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Stevenson", "__class__": "Mover"}, "motion_texts": [{"string": "The meeting BE ADJOURNED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The meeting adjourned at 11:45 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2023-01-23 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}