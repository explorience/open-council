_": "Vote"}, "result": {"string": "Motion Passed (13 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-07 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "5th Report of the Diversity Inclusion and Anti-Oppression Advisory Committee", "number": "3", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lehman", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by M. Cassidy", "__class__": "Mover"}, "motion_texts": [{"string": "That the following actions be taken with respect to the Diversity, Inclusion and Anti-Oppression Advisory Committee from its meeting held on August 19, 2021:\n\n\n\na)\u00a0 the following actions be taken with respect to the Awards and Recognition Sub-Committee update:\n\n\n\ni)\u00a0 \u00a0the request from the Awards and Recognition Sub-Committee for budget allocation of up to $700.00 for the 2021 Diversity, Race Relations and Inclusivity Award, BE APPROVED; and,\n\n\n\nii)\u00a0 it BE NOTED that the verbal update from A. Husain with respect to the Awards and Recognition Sub-Committee meeting was received; and,\n\n\n\nb)\u00a0 that clauses 1.1, 1.2, 2.1, 2.2, 3.1, 4.1, 4.2, 5.2, 5.3, 5.4, 6.1 and 7.1 BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "Absent:", "voters": ["A. Kayabaga"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-07 16:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=84593", "title": "2021-09-07 DIAAC Report", "date": "2021-09-07 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "4": {"title": "London Transit Commission Vacancy", "number": "4", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Squire", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "That the resignation of Tanya Park from the London Transit Commission as of October 22, 2021 BE ACCEPTED and the City Clerk BE DIRECTED to publicly advertise for a replacement appointment with applications to be considered at the next meeting of the Strategic Priorities and Policy Committee.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "Absent:", "voters": ["A. Kayabaga"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-07 16:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=84594", "title": "2021-09-07 Submission - LTC Vacancy", "date": "2021-09-07 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Appointment to the London Hydro Inc. Board of Directors", "number": "5", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by M. van Holst", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Corporate Services Committee, the attached proposed by-law (Appendix \u201cA\u201d) BE INTRODUCED at the Municipal Council meeting to be held September 14, 2021 to:", "__clas