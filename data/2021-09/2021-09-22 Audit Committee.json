ng": "That the communication from Deloitte, regarding the internal audit dashboard as at September 10, 2021, BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-22 12:00:00", "attachments": [{"empty_flag": false, "title": "2021-09-22 Submission - Dashboard", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=85605", "date": "2021-09-22 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Internal Audit Summary Update", "number": "4", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "That the communication dated September 22, 2021, from Deloitte, with respect to the internal audit summary update, BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-22 12:00:00", "attachments": [{"empty_flag": false, "title": "2021-09-22 Submission - Internal Summary Update", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=85606", "date": "2021-09-22 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2021-09-22 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2021-09-22 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Confidential (Enclosed for Members only.)", "number": "6", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "That the Audit Committee convene, In Closed Session, for the purpose of considering the following:", "__class__": "Paragraph"}, {"string": "6.1. \u00a0 \u00a0Confidential Trade Secret or Scientific, Technical, Commercial, Financial or Labour Relations Information, Supplied to the City / Personal Matters/Identifiable Individual", "__class__": "Paragraph"}, {"string": "A matter pertaining to the security of the property of the Corporation as it contains commercial and financial information supplied in confidence to the Corporation, the disclosure of which could be reasonably expected to prejudice significantly the competitive position or interfere significantly with the contractual or other negotiations of a person, group of persons or organization, result in similar information no longer being supplied to the Corporation where it in the public interest that similar information continue to be so supplied and result in undue loss or gain to any person, group, committee or financial institution or agency and matters related to the personal information about identifiable individuals, including municipal or local board employees related to the potential provision of internal audit services for the City of London, by an external organization.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The Commiittee convened in closed session from 12:18 PM to 3:13 PM; it being noted that the Committee recessed, from public session, from 12:35 PM to 12:55 PM and from 2:06 PM to 2:25 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-22 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Adjournment", "number": "7", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "That the meeting be adjourned.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The meeting adjourned at 3:14 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2021-09-22 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}