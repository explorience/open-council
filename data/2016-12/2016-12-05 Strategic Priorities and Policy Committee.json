ns", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (14)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "That Councillor P. Hubert BE APPOINTED to\n  serve as Chair of the Corporate Services Committee for the term ending\n  November 30, 2018; it being noted that Councillor P. Hubert was selected in\n  accordance with the attached ranked ballot.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "ADDED - DELEGATION\n  - Vinay Sharma, Chief Executive Officer, London Hydro re Hydro Industry\n  Consolidation", "number": "5", "content": [{"string": "That the communication dated December 1,\n  2016 from M. Mathur, Chair, London Hydro Inc., Board of Directors, as well as\n  the associated verbal delegation from V. Sharma, Chief Executive Officer and\n  M. Mathur, Chair, London Hydro Inc. Board of Directors, with respect to a\n  potential merger opportunity for London Hydro, BE RECEIVED.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (14)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "That the Civic Administration BE DIRECTED\n  to report back at a future meeting of the Strategic Priorities and Policy\n  Committee, with respect to potential financial, economic and legal\n  implications that may result from London Hydro investigating possible\n  mergers, acquisitions, amalgamations and dispositions, which may include\n  taking on strategic partners.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (12)"]}, {"vote": "Nays:", "voters": ["M. Salih", "A. Hopkins (2)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"string": "That the Civic Administration BE REQUESTED\n  to report back on how the City of London can assist with the growth of our\n  film industry, including the possibility of creating a Film Industry\n  Development Office.", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher", "T. Park (14)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "8": {"title": "ADDED - COUNCIL\n  MEMBER SUBMISSION - Council Reconfiguration", "number": "8", "content": [{"string": "That the communication dated December 2,\n  2016, from Councillor P. Hubert, with respect to the potential\n  reconfiguration of the Municipal Council, BE RECEIVED.", "__class__": "Paragraph"}, {"pre_motion_texts"