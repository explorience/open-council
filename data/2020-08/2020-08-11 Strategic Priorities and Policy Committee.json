tle": "2020-08-11 Staff Report - Strat Plan Progress Variance", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=74010", "date": "2020-08-11 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Climate Emergency Action Plan Update", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Cassidy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by A. Hopkins", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Managing Director, Environmental and Engineering Services and City Engineer and the Managing Director, Development and Compliance Services and Chief Building Official, the staff report dated August 11, 2020 with respect to the City\u2019s Climate Emergency Action Plan BE RECEIVED for information.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "M. van Holst", "M. Salih", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner"]}, {"vote": "Absent:", "voters": ["S. Hillier", "Mayor E. Holder", "J. Helmer"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (12 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [{"empty_flag": false, "title": "2020-08-11 Staff Report - Climate Emergency Action Plan", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=74011", "date": "2020-08-11 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2020-08-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "Request for Third Term Appointment to the Greater London International Airport Authority Board of Directors", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Van Meerbergen", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by A. Hopkins", "__class__": "Mover"}, "motion_texts": [{"string": "That Bill Graham BE APPOINTED for a third and final term to the Greater London International Airport Authority Board of Directors for the term ending July 31, 2023; it being noted that the Strategic Priorities and Policy Committee received a communication dated July 10, 2020 from Michelle T. Faysal, Chair, Board of Directors, Greater London International Airport Authority with respect to this matter.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "M. van Holst", "M. Salih", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins"]}, {"vote": "Nays:", "voters": ["A. Kayabaga", "S. Turner"]}, {"vote": "Absent:", "voters": ["S. Hillier", "Mayor E. Holder", "J. Helmer"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (10 to 2)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [{"empty_flag": false, "title": "2020-08-11 Submission - GLIAA", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=74008", "date": "2020-08-11 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "London Community Grants Program Allocations", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Salih", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J. Morgan", "__class__": "Mover"}, "motion_texts": [{"string": "That the following actions be taken with respect to the London Community Grants Program, related Council Policy and funding allocation:", "__class__": "Paragraph"}, {"string": "a)\u00a0 \u00a0 \u00a0for the Multi-Year Funding Allocation for the period 2024-2027, the Civic Administration BE DIRECTED to provide for a minimum of 25% ($500,000) of the total funding available to be allocated to applications whose proposals would support anti-Black racism, anti-Indigenous racism, anti-oppression, diversity, inclusion and equity; it being noted that if no applications are received that would support these initiatives, the funding may be allocated to those applications that meet the \u201cLondon Community Grants Program Policy\u201d;", "__class__": "Paragraph"}, {"string": "b)\u00a0 \u00a0the Civic Administration BE DIRECTED to bring forward any necessary amendments to the \u201cLondon Community Grants Policy\u201d to implement a) above and to provide for applications that support the initiatives listed in a) above, to be eligible under the annual Innovation and Capital Funding Stream allocations; it being noted that such applications would be subject the community panel review process as provided for in the Policy; and,", "__class__": "Paragraph"}, {"string": "c)\u00a0 \u00a0 the Civic Administration BE DIRECTED to remove any barriers that racialized and marginalized groups may face applying to the London Community Grants Program", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "M. van Holst", "M. Salih", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins"]}, {"vote": "Nays:", "voters": ["S. Turner"]}, {"vote": "Absent:", "voters": ["S. Hillier", "Mayor E. Holder", "J. Helmer"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (11 to 1)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [{"empty_flag": false, "title": "2020-08-11 Submission - Community Grants", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=74012", "date": "2020-08-11 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2020-08-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {"1": {"title": "(ADDED) Confirmation of Appointment to the Middlesex-London Food Policy Council", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by P. Squire", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by S. Lewis", "__class__": "Mover"}, "motion_texts": [{"string": "That Councillor M. van Holst BE APPOINTED to the Middlesex-London Food Policy Council for the term ending November 15, 2022.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "M. van Holst", "M. Salih", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner"]}, {"vote": "Absent:", "voters": ["S. Hillier", "Mayor E. Holder", "J. Helmer"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (12 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [{"empty_flag": false, "title": "2020-08-11 Submission - MLFPC", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=74013", "date": "2020-08-11 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2020-08-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Adjournment", "number": "6", "content": [{"string": "The meeting adjourned at 5:18 PM.", "__class__": "Paragraph"}], "items": {}, "datetime": "2020-08-11 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}