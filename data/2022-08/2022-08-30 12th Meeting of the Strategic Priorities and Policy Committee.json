        "1": {
          "title": "Allocation of Remaining London Community Recovery Network (LCRN) Funding",
          "number": "1",
          "content": [
            {
              "pre_motion_texts": [],
              "moved_by": {
                "string": "Moved by M. Cassidy",
                "__class__": "Mover"
              },
              "seconded_by": {
                "string": "Seconded by J. Fyfe-Millar",
                "__class__": "Mover"
              },
              "motion_texts": [
                {
                  "string": "That the Civic Administration, including (but not limited to) staff in Social and Health Development BE DIRECTED to work together with Community Partners to develop London Community Recovery Network (LCRN) business cases with a focus on addressing London\u2019s social recovery, especially in mitigating the effects of homelessness, precarious employment, food insecurity, etc; it being noted that the Strategic Priorities and Policy Committee received a communication dated August 25, 2022 from K. Pagniello, Executive Director, M. Laliberte, Staff Lawyer and T. Kiefer, Housing Support Worker, Neighbourhood Legal Services with respect to this matter.",
                  "__class__": "Paragraph"
                }
              ],
              "vote": {
                "rows": [
                  {
                    "vote": "Yeas:",
                    "voters": [
                      "M. van Holst",
                      "M. Salih",
                      "J. Helmer",
                      "M. Cassidy",
                      "J. Morgan",
                      "A. Hopkins",
                      "S. Turner",
                      "S. Lewis",
                      "S. Hillier",
                      "E. Peloza",
                      "P. Van Meerbergen",
                      "S. Lehman",
                      "Mayor E. Holder",
                      "J. Fyfe-Millar,M. Hamou"
                    ]
                  }
                ],
                "__class__": "Vote"
              },
              "result": {
                "string": "Motion Passed (15 to 0)",
                "__class__": "MotionResult"
              },
              "post_motion_texts": [],
              "__class__": "Motion"
            }
