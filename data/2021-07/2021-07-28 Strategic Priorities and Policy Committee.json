scribemeetings.com/filestream.ashx?DocumentId=82922", "title": "2021-07-28 Staff Report - Municipal Accommodation Tax", "date": "2021-07-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Diversity Inclusion and Anti-Oppression Advisory Committee", "number": "3", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Helmer", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "That the following actions be taken with respect to the 3rd and 4th Reports of the Diversity Inclusion and Anti-Oppression Advisory Committee from its meetings held on June 17 and July 15, 2021, respectively:\n\n\n\na) clauses 1.1, 1.2, 2.1, 2.2, 3.1, 3.2, 3.3, 4.1 and 4.2, inclusive of the 3rd Report of the Diversity Inclusion and Anti-Oppression Advisory Committee BE RECEIVED;\n\n\n\nb) the following actions be taken with respect to the Election of Community Diversity and Inclusion Strategy (CDIS) Leadership Table Representative:\n\n\n\ni) the Civic Administration BE REQUESTED to attend the next Diversity, Inclusion and Anti-Oppression Advisory Committee to provide an overview of CDIS; and,\n\nii) the election of the representative BE POSTPONED to the next meeting;\n\n\n\nc) clauses 1.1, 1.2, 2.1, 2.2, 3.1, 4.1, 5.2, 5.3, 5.4, 5.5, 5.6, 5.7 and 6.1 of the 4th Report of the Diversity Inclusion and Anti-Oppression Advisory Committee BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [], "items": {"1": {"title": "Request for Delegation Status - Roula Hawa, Mischa Mackie (Schlemmer) and Reeti Chopra - Housing and Homelessness Crisis", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by A. Hopkins", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by M. Cassidy", "__class__": "Mover"}, "motion_texts": [{"string": "The following actions be taken with respect to the delegation from Roula Hawa, Mischa Mackie (Schlemmer) and Reeti Chopra related to the Housing and Homelessness Crisis in London:", "__class__": "Paragraph"}, {"string": "a)\u00a0 \u00a0the above-noted presentation BE RECEIVED: and,", "__class__": "Paragraph"}, {"string": "b)\u00a0 \u00a0the recommendations forming part of the presentation BE FORWARDED to the Civic Administration, for consideration and potential implementation, including but not limited to participation in the knowledge-exchange activities related to this report.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "Absent:", "voters": ["S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Additional votes:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Cassidy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by M. van Holst", "__class__": "Mover"}, "motion_texts": [{"string": "That the requested delegation status for Roula Hawa, Mischa Mackie (Schlemmer) and Reeti Chopra BE APPROVED to be heard at this time.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "Absent:", "voters": ["S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=82919", "title": "2021-07-28 Submission - Recommendations Brescia and Gender-Based Violence Project 2021", "date": "2021-07-28 00:00:00", "local_page": null, "__class__": "Attachment"}, {"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=82920", "title": "2021-07-28 Presenation - Housing and Homelessness Crisis", "date": "2021-07-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consideration of Appointment to the London & Middlesex Community Housing Board (Requires 1 Council Member)", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by P. Van Meerbergen", "__class__": "Mover"}, "motion_texts": [{"string": "That Councillor J. Morgan BE APPOINTED to the London & Middlesex Community Housing Board for the term ending November 15, 2022.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "Nays:", "voters": ["J. Helmer"]}, {"vote": "Absent:", "voters": ["S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (13 to 1)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Voting Record:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Appointment of a Council Member to the London and Middlesex Community Housing Board", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "J.", "voters": ["M. van Holst", "P. Squire", "J. Morgan", "S. Lewis", "S. Hillier", "E. Peloza", "P. Van Meerbergen", "S. Lehman,Mayor E. Holder"]}, {"vote": "A.", "voters": ["M. Salih", "J. Helmer", "M. Cassidy", "A. Hopkins,A. Kayabaga"]}, {"vote": "Abstain(0.00", "voters": ["None"]}, {"vote": "Absent(7.14", "voters": ["S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Majority Winner: J. Morgan", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "5": {"title": "Deferred Matters/Additional Business", "number": "5", "content": [], "items": {"1": {"title": "(ADDED) Consideration of Vaccine Mandates", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "That the communication dated July 26, 2021 from Councillor M. van Holst BE RECEIVED and no further action BE TAKEN.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Salih", "J. Helmer", "P. Squire", "J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "S. Lehman,Mayor E. Holder"]}, {"vote": "Nays:", "voters": ["M. van Holst,M. Cassidy"]}, {"vote": "Absent:", "voters": ["S. Turner,P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (11 to 2)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=82923", "title": "2021-07-28 Submission - Consideration of Vaccine Mandates", "date": "2021-07-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}, "2": {"title": "(ADDED) Regional Transportation and Mobility Across Southwestern Ontario", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Mayor E. Holder", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J. Morgan", "__class__": "Mover"}, "motion_texts": [{"string": "That, the following actions be taken with respect to the communication dated July 27, 2021 from Mayor E. Holder and Deputy Mayor J. Morgan regarding the Regional Transportation and Mobility across Southwestern Ontario :\n\n\n\na) \u00a0 \u00a0the Civic Administration BE DIRECTED to develop a conceptual framework for a Regional Transportation/Mobility Hub in downtown London, including working with London Transit to explore potential connections between a regional transportation/mobility hub and local City of London transit routes, including the proposed bus rapid transit system, for Council\u2019s consideration; and,\n\n\n\nb)\u00a0 \u00a0the Mayor BE REQUESTED to engage with the Southwest Ontario Transportation Task Force membership on the opportunity of positioning the City of London as a Regional Transportation/Mobility Hub for consideration by the Province of Ontario under the Connecting the Southwest: A Draft Transportation Plan for Southwestern Ontario.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "S. Lehman,Mayor E. Holder"]}, {"vote": "Absent:", "voters": ["S. Turner,P. Van Meerbergen"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (13 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [{"empty_flag": false, "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=82924", "title": "2021-07-28 Submission - Regional Transportation and Mobility Across Southwestern Ontario", "date": "2021-07-28 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Adjournment", "number": "6", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by E. Peloza", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by A. Hopkins", "__class__": "Mover"}, "motion_texts": [{"string": "That the meeting BE ADJOURNED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The meeting adjourned at 5:16 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2021-07-28 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}