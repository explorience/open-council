motion_texts": [{"string": "WHEREAS the Municipal Council of The Corporation of the City of London acknowledges that systemic anti-Black, anti-Indigenous and people of colour racism exists in London;", "__class__": "Paragraph"}, {"string": "AND WHEREAS the Municipal Council unequivocally condemns racism in all of its forms:", "__class__": "Paragraph"}, {"string": "AND WHEREAS the Municipal Council acknowledges that the Corporation\u2019s workforce is not reflective of the population it services and that it will continue to work to ensure a reflective workforce;", "__class__": "Paragraph"}, {"string": "AND WHEREAS the Municipal Council affirms the commitment to help eradicate anti-Black, anti-Indigenous and people of colour oppression:", "__class__": "Paragraph"}, {"string": "NOW THEREFORE IT BE RESOLVED THAT the Civic Administration BE DIRECTED to", "__class__": "Paragraph"}, {"string": "a)\u00a0 \u00a0 \u00a0report back to a future meeting of the appropriate Standing Committee with an update on the implementation of the Community Diversity & Inclusion Strategy, providing specific details with respect to the equity and inclusion lens of the Strategy and the next steps that will be taken to end racism in London;", "__class__": "Paragraph"}, {"string": "b)\u00a0 \u00a0 \u00a0report back to the appropriate Standing Committee with respect to metrics that may be or are currently implemented to demonstrate progress with respect to hiring to reflect the diversity of the community; and", "__class__": "Paragraph"}, {"string": "c)\u00a0 \u00a0 \u00a0 report back to the appropriate Standing Committee with respect the establishment of a Black Liaison Officer position at the City of London, similar to the previously approved Indigenous Liaison Officer position, including input from the community and related financing, with respect to this matter.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "Mayor E. Holder", "M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-06-09 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "London Boards - Black Lives Matter Rally", "number": "2", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Helmer", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Mayor E. Holder", "__class__": "Mover"}, "motion_texts": [{"string": "That the following actions be taken with respect to the City of London Boards:", "__class__": "Paragraph"}, {"string": "a)\u00a0 \u00a0 \u00a0 the London Police Services Board and all School Boards operating in London BE REQUESTED to respond to the issues raised by Londoners during the Black Lives Matter Rally held on June 6, 2020; and,", "__class__": "Paragraph"}, {"string": "b)\u00a0 \u00a0 \u00a0 the Middlesex-London Health Unit Board BE REQUESTED to respond to the issues raised by Londoners during the Black Lives Matter Rally held on June 6, 2020.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Voting Record:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Helmer", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Mayor E. Holder", "__class__": "Mover"}, "motion_texts": [{"string": "That the London Police Services Board and all School Boards operating in London BE REQUESTED to respond to the issues raised by Londoners during the Black Lives Matter Rally held on June 6, 2020.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "Mayor E. Holder", "M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Helmer", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Mayor E. Holder", "__class__": "Mover"}, "motion_texts": [{"string": "That the Middlesex-London Health Unit Board BE REQUESTED to respond to the issues raised by Londoners during the Black Lives Matter Rally held on June 6, 2020.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "Mayor E. Holder", "M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins"]}, {"vote": "Recuse:", "voters": ["S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (14 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2020-06-09 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2020-06-09 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "Adjournment", "number": "6", "content": [{"string": "The meeting adjourns at 7:31 PM.", "__class__": "Paragraph"}], "items": {}, "datetime": "2020-06-09 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}