}, "3": {"title": "Scheduled Items", "number": "3", "content": [], "items": {"1": {"title": "Housing Development Corporation, London - 2019 Annual Meeting of the Shareholder Annual Resolutions", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Turner", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J. Morgan", "__class__": "Mover"}, "motion_texts": [{"string": "That the following actions be taken with respect to the 2019 Annual General Meeting of the Housing Development Corporation, London:\n\n\n\na)\u00a0 \u00a0 \u00a0 the presentation by S. Giustizia, President and CEO, Housing Development Corporation, London BE RECEIVED;\n\n\n\nb)\u00a0 \u00a0 \u00a0 the proposed by-law appended to the staff report dated June 9, 2020 as Appendix \u201cA\u201d entitled \u201cA by-law to ratify and confirm the Annual Resolutions of the Shareholder of the Housing Development Corporation, London\u201d, BE INTRODUCED at the Municipal Council meeting to be held on June 16, 2020 to:\u00a0\n\n\n\n\u00a0 \u00a0 \u00a0i) ratify and confirm the Annual Resolution of the Shareholder of Housing Development Corporation, London; and,\n\n\n\n\u00a0 \u00a0 \u00a0ii) authorize the Mayor and the City Clerk to execute the Annual Resolution of the Shareholder of Housing Development Corporation, London;\n\n\n\nc)\u00a0 \u00a0 \u00a0 the Housing Development Corporation, London - 2019 Annual Shareholder Report BE RECEIVED; and\n\n\n\nd)\u00a0 \u00a0 \u00a0 the financial statements of the Housing Development Corporation, London year ended December 31, 2019 BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "S. Hillier", "A. Kayabaga", "E. Peloza", "P. Van Meerbergen", "S. Lehman", "Mayor E. Holder", "M. van Holst", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "S. Turner"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (15 to 0)", "__class__": "MotionResul