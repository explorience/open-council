  "__class__": "Meeting",
  "transcript": [
    {
      "index": 1,
      "start": "00:16:11.070",
      "end": "00:16:14.030",
      "text": "All right, thank you, please be seated."
    },
    {
      "index": 2,
      "start": "00:16:14.030",
      "end": "00:16:15.420",
      "text": "This is the 13th meeting of council."
    },
    {
      "index": 3,
      "start": "00:16:15.420",
      "end": "00:16:17.670",
      "text": "This is a special meeting that I've called to deal"
    },
    {
      "index": 4,
      "start": "00:16:17.670",
      "end": "00:16:20.790",
      "text": "with a couple of bylaws that we need third reading of."
    },
    {
      "index": 5,
      "start": "00:16:20.790",
      "end": "00:16:22.880",
      "text": "Now that the province has signed off"
    },
    {
      "index": 6,
      "start": "00:16:22.880",
      "end": "00:16:26.710",
      "text": "on some of our policy and official plan changes,"
    },
    {
      "index": 7,
      "start": "00:16:26.710",
      "end": "00:16:28.430",
      "text": "requires the third reading of the bylaw."
    },
    {
      "index": 8,
      "start": "00:16:28.430",
      "end": "00:16:29.410",
      "text": "The sooner we do that,"
    },
    {
      "index": 9,
      "start": "00:16:29.410",
      "end": "00:16:30.980",
      "text": "the sooner the appeal of the period starts,"
    },
    {
      "index": 10,
      "start": "00:16:30.980",
      "end": "00:16:34.030",
      "text": "the sooner these actual heights and densities"
    },
    {
      "index": 11,
      "start": "00:16:34.030",
      "end": "00:16:37.500",
      "text": "can be preceded on with those who are interested"
    },
    {
      "index": 12,
      "start": "00:16:37.500",
      "end": "00:16:38.920",
      "text": "in pursuing them without having to go through"
    },
    {
      "index": 13,
      "start": "00:16:38.920",
      "end": "00:16:41.690",
      "text": "the full visual plan amendment process,"
    },
    {
      "index": 14,
      "start": "00:16:41.690",
      "end": "00:16:42.860",
      "text": "which is a much longer process."
    },
    {
      "index": 15,
      "start": "00:16:42.860",
      "end": "00:16:45.690",
      "text": "So hopefully this won't be a long meeting,"
    },
    {
      "index": 16,
      "start": "00:16:45.690",
      "end": "00:16:47.610",
      "text": "but it is a formal meeting of council."
    },
    {
      "index": 17,
      "start": "00:16:47.610",
      "end": "00:16:55.360",
      "text": "So we're gonna go through a number of the items"
    },
    {
      "index": 18,
      "start": "00:16:55.360",
      "end": "00:16:56.460",
      "text": "that we would normally go through"
    },
    {
      "index": 19,
      "start": "00:16:56.460",
      "end": "00:17:07.440",
      "text": "at the opening of a council meeting."
    },
    {
      "index": 20,
      "start": "00:17:07.440",
      "end": "00:17:08.880",
      "text": "So what we're gonna do is we're gonna start off"
    },
    {
      "index": 21,
      "start": "00:17:08.880",
      "end": "00:18:36.500",
      "text": "with rising and listening to a rendition of O Canada."
    },
    {
      "index": 22,
      "start": "00:18:36.500",
      "end": "00:18:41.100",
      "text": "Thank you, please be seated."
    },
    {
      "index": 23,
      "start": "00:18:41.100",
      "end": "00:18:43.050",
      "text": "We acknowledge we are gathered today on the traditional lands"
    },
    {
      "index": 24,
      "start": "00:18:43.050",
      "end": "00:18:45.100",
      "text": "of the Anishinaabak, Haudenosaunee, Lenny Paywalk"
    },
    {
      "index": 25,
      "start": "00:18:45.100",
      "end": "00:18:46.330",
      "text": "and Adawandran peoples."
    },
    {
      "index": 26,
      "start": "00:18:46.330",
      "end": "00:18:48.000",
      "text": "We honor and respect the history languages"
    },
    {
      "index": 27,
      "start": "00:18:48.000",
      "end": "00:18:49.820",
      "text": "and cultures of the diverse indigenous people"
    },
    {
      "index": 28,
      "start": "00:18:49.820",
      "end": "00:18:51.490",
      "text": "who call this territory home."
    },
    {
      "index": 29,
      "start": "00:18:51.490",
      "end": "00:18:52.640",
      "text": "We acknowledge all of the treaties"
    },
    {
      "index": 30,
      "start": "00:18:52.640",
      "end": "00:18:53.780",
      "text": "that are specific to this area,"
    },
    {
      "index": 31,
      "start": "00:18:53.780",
      "end": "00:18:55.110",
      "text": "the two row Wampum Belt Treaty"
    },
    {
      "index": 32,
      "start": "00:18:55.110",
      "end": "00:18:57.990",
      "text": "of the Haudenosaunee Confederacy Silver Covenant Chain,"
    },
    {
      "index": 33,
      "start": "00:18:57.990",
      "end": "00:18:58.960",
      "text": "the Beaver Hunting Grounds"
    },
    {
      "index": 34,
      "start": "00:18:58.960",
      "end": "00:19:01.990",
      "text": "of the Haudenosaunee Nan Fan Treaty of 1701,"
    },
    {
      "index": 35,
      "start": "00:19:01.990",
      "end": "00:19:04.170",
      "text": "the McKee Treaty of 1790,"
    },
    {
      "index": 36,
      "start": "00:19:04.170",
      "end": "00:19:06.660",
      "text": "the London Township Treaty of 1796,"
    },
    {
      "index": 37,
      "start": "00:19:06.660",
      "end": "00:19:09.610",
      "text": "the Huron Track Treaty of 1827 with the Anishinaabak"
    },
    {
      "index": 38,
      "start": "00:19:09.610",
      "end": "00:19:11.500",
      "text": "and the Dish with One Spoon Covenant Wampum"
    },
    {
      "index": 39,
      "start": "00:19:11.500",
      "end": "00:19:13.960",
      "text": "of the Anishinaabak and Haudenosaunee."
    },
    {
      "index": 40,
      "start": "00:19:13.960",
      "end": "00:19:15.380",
      "text": "Three indigenous nations that are neighbors"
    },
    {
      "index": 41,
      "start": "00:19:15.380",
      "end": "00:19:17.500",
      "text": "to Lenny are the Chippewaas of the Thames First Nation,"
    },
    {
      "index": 42,
      "start": "00:19:17.500",
      "end": "00:19:20.190",
      "text": "Oneida Nation of the Thames and the Muncie Delaware Nation,"
    },
    {
      "index": 43,
      "start": "00:19:20.190",
      "end": "00:19:22.030",
      "text": "while continuing to live as sovereign nations"
    },
    {
      "index": 44,
      "start": "00:19:22.030",
      "end": "00:19:26.730",
      "text": "with individual and unique languages, cultures and customs."
    },
    {
      "index": 45,
      "start": "00:19:26.730",
      "end": "00:19:28.550",
      "text": "City of London is committed to making every effort"
    },
    {
      "index": 46,
      "start": "00:19:28.550",
      "end": "00:19:29.810",
      "text": "to providing alternate formats"
    },
    {
      "index": 47,
      "start": "00:19:29.810",
      "end": "00:19:31.870",
      "text": "and communication supports for meetings upon request"
    },
    {
      "index": 48,
      "start": "00:19:31.870",
      "end": "00:19:34.760",
      "text": "to make a request specific to this meeting of council."
    },
    {
      "index": 49,
      "start": "00:19:34.760",
      "end": "00:19:37.720",
      "text": "You can contact councilagenda@london.ca"
    },
    {
      "index": 50,
      "start": "00:19:37.720",
      "end": "00:19:42.980",
      "text": "or 519-661-2489, extension 2425."
    },
    {
      "index": 51,
      "start": "00:19:42.980",
      "end": "00:19:46.690",
      "text": "I just wanna recognize that we have several"
    },
    {
      "index": 52,
      "start": "00:19:46.690",
      "end": "00:19:48.180",
      "text": "colleagues joining us online."
    },
    {
      "index": 53,
      "start": "00:19:48.180",
      "end": "00:19:52.110",
      "text": "We have Councillor Van Mirbergen, Councillor Frank,"
    },
    {
      "index": 54,
      "start": "00:19:52.110",
      "end": "00:19:56.050",
      "text": "Councillor Lehman and Councillor Palosa as well,"
    },
    {
      "index": 55,
      "start": "00:19:56.050",
      "end": "00:19:59.750",
      "text": "as well along with those who have joined in council chambers."
    },
    {
      "index": 56,
      "start": "00:19:59.750",
      "end": "00:20:06.810",
      "text": "I'll start with any disclosures of pecuniary interest."
    },
    {
      "index": 57,
      "start": "00:20:06.810",
      "end": "00:20:09.270",
      "text": "Seeing none, there aren't any recognitions for this,"
    },
    {
      "index": 58,
      "start": "00:20:09.270",
      "end": "00:20:11.250",
      "text": "there aren't any confidential matters,"
    },
    {
      "index": 59,
      "start": "00:20:11.250",
      "end": "00:20:13.740",
      "text": "there's no closed session, there's no minutes,"
    },
    {
      "index": 60,
      "start": "00:20:13.740",
      "end": "00:20:15.280",
      "text": "there's no communications or positions,"
    },
    {
      "index": 61,
      "start": "00:20:15.280",
      "end": "00:20:18.050",
      "text": "no notices of which motion is given, no reports,"
    },
    {
      "index": 62,
      "start": "00:20:18.050",
      "end": "00:20:20.150",
      "text": "no added reports, no deferred items,"
    },
    {
      "index": 63,
      "start": "00:20:20.150",
      "end": "00:20:22.620",
      "text": "any inquiries related to the items that we're here for?"
    },
    {
      "index": 64,
      "start": "00:20:22.620",
      "end": "00:20:26.320",
      "text": "Nope, no emergent motions, that brings us to bylaws."
    },
    {
      "index": 65,
      "start": "00:20:26.320",
      "end": "00:20:32.030",
      "text": "We have three bylaws that require a first, second"
    },
    {
      "index": 66,
      "start": "00:20:32.030",
      "end": "00:20:35.310",
      "text": "and third reading, and as I mentioned at the outset,"
    },
    {
      "index": 67,
      "start": "00:20:35.310",
      "end": "00:20:38.910",
      "text": "these are bylaws that, oh, actually they only require"
    },
    {
      "index": 68,
      "start": "00:20:38.910",
      "end": "00:20:41.800",
      "text": "third reading for, sorry, first, second and third reading"
    },
    {
      "index": 69,
      "start": "00:20:41.800",
      "end": "00:20:43.820",
      "text": "for the confirmation bylaw."
    },
    {
      "index": 70,
      "start": "00:20:43.820",
      "end": "00:20:45.800",
      "text": "Only third reading for the other two bylaws,"
    },
    {
      "index": 71,
      "start": "00:20:45.800",
      "end": "00:20:48.050",
      "text": "'cause we've already passed first and second reading"
    },
    {
      "index": 72,
      "start": "00:20:48.050",
      "end": "00:20:49.990",
      "text": "into previous council."
    },
    {
      "index": 73,
      "start": "00:20:49.990",
      "end": "00:20:52.080",
      "text": "Since then, the province has now signed off"
    },
    {
      "index": 74,
      "start": "00:20:52.080",
      "end": "00:20:55.220",
      "text": "on and approved our request."
    },
    {
      "index": 75,
      "start": "00:20:55.220",
      "end": "00:20:56.800",
      "text": "So now we can pass the third reading,"
    },
    {
      "index": 76,
      "start": "00:20:56.800",
      "end": "00:20:58.730",
      "text": "bringing it into the policy and enforcement effect"
    },
    {
      "index": 77,
      "start": "00:20:58.730",
      "end": "00:21:01.260",
      "text": "and beginning the appeals period on these items."
    },
    {
      "index": 78,
      "start": "00:21:01.260",
      "end": "00:21:03.810",
      "text": "Again, this was called as a special council meeting,"
    },
    {
      "index": 79,
      "start": "00:21:03.810",
      "end": "00:21:05.730",
      "text": "'cause the sooner we start the appeals period,"
    },
    {
      "index": 80,
      "start": "00:21:05.730",
      "end": "00:21:08.570",
      "text": "sooner it can conclude, the sooner people can proceed"
    },
    {
      "index": 81,
      "start": "00:21:08.570",
      "end": "00:21:11.710",
      "text": "with building housing under the new density limits"
    },
    {
      "index": 82,
      "start": "00:21:11.710",
      "end": "00:21:13.680",
      "text": "related to these bylaws in the community."
    },
    {
      "index": 83,
      "start": "00:21:13.680",
      "end": "00:21:28.670",
      "text": "So I'll look for, okay, so what we're gonna do"
    },
    {
      "index": 84,
      "start": "00:21:28.670",
      "end": "00:21:31.040",
      "text": "is we're gonna do first and then second reading"
    },
    {
      "index": 85,
      "start": "00:21:31.040",
      "end": "00:21:34.090",
      "text": "of the confirming bylaw, and then we can do third reading"
    },
    {
      "index": 86,
      "start": "00:21:34.090",
      "end": "00:21:35.860",
      "text": "of all three of them together."
    },
    {
      "index": 87,
      "start": "00:21:35.860",
      "end": "00:21:37.990",
      "text": "So I'm gonna look for someone who wants to be a mover"
    },
    {
      "index": 88,
      "start": "00:21:37.990",
      "end": "00:21:39.480",
      "text": "and seconder for all of those items."
    },
    {
      "index": 89,
      "start": "00:21:39.480",
      "end": "00:21:42.900",
      "text": "Councilor Cuddy, seconded by Deputy Mayor Lewis."
    },
    {
      "index": 90,
      "start": "00:21:42.900",
      "end": "00:21:46.260",
      "text": "So we'll start with just first reading,"
    },
    {
      "index": 91,
      "start": "00:21:46.260",
      "end": "00:21:48.980",
      "text": "the confirming bylaw related to the meeting"
    },
    {
      "index": 92,
      "start": "00:21:48.980",
      "end": "00:21:50.720",
      "text": "that we're having today."
    },
    {
      "index": 93,
      "start": "00:21:50.720",
      "end": "00:21:57.030",
      "text": "We'll open that for voting."
    },
    {
      "index": 94,
      "start": "00:21:57.030",
      "end": "00:22:00.050",
      "text": "Let's go vote yes."
    },
    {
      "index": 95,
      "start": "00:22:00.050",
      "end": "00:22:06.740",
      "text": "Vote yes as well."
    },
    {
      "index": 96,
      "start": "00:22:06.740",
      "end": "00:22:10.540",
      "text": "Closing the vote, motion carries 14 to zero."
    },
    {
      "index": 97,
      "start": "00:22:10.540",
      "end": "00:22:12.720",
      "text": "Now second reading, same mover and seconder on this,"
    },
    {
      "index": 98,
      "start": "00:22:12.720",
      "end": "00:22:16.230",
      "text": "any discussion on the second reading?"
    },
    {
      "index": 99,
      "start": "00:22:16.230",
      "end": "00:22:26.730",
      "text": "Seeing none, we'll open second."
    },
    {
      "index": 100,
      "start": "00:22:26.730",
      "end": "00:22:32.780",
      "text": "So votes yes."
    },
    {
      "index": 101,
      "start": "00:22:32.780",
      "end": "00:22:39.200",
      "text": "Councilor Frank, closing the vote."
    },
    {
      "index": 102,
      "start": "00:22:39.200",
      "end": "00:22:42.940",
      "text": "Yes, closing the vote, motion carries 14 to zero."
    },
    {
      "index": 103,
      "start": "00:22:42.940",
      "end": "00:22:44.530",
      "text": "All right, now third reading will be"
    },
    {
      "index": 104,
      "start": "00:22:44.530",
      "end": "00:22:47.780",
      "text": "all of the bylaws on both the confirming bylaw"
    },
    {
      "index": 105,
      "start": "00:22:47.780",
      "end": "00:22:50.120",
      "text": "as well as the two related bylaws"
    },
    {
      "index": 106,
      "start": "00:22:50.120",
      "end": "00:22:52.230",
      "text": "that only require third reading"
    },
    {
      "index": 107,
      "start": "00:22:52.230",
      "end": "00:22:53.540",
      "text": "that we've done first and second reading"
    },
    {
      "index": 108,
      "start": "00:22:53.540",
      "end": "00:22:56.110",
      "text": "at a previous council meeting yet."
    },
    {
      "index": 109,
      "start": "00:22:56.110",
      "end": "00:22:57.190",
      "text": "So this is third reading."
    },
    {
      "index": 110,
      "start": "00:22:57.190",
      "end": "00:23:01.450",
      "text": "So there's no debate on third reading."
    },
    {
      "index": 111,
      "start": "00:23:01.450",
      "end": "00:23:04.300",
      "text": "Yes, is it a point of order, Councilor Trossal?"
    },
    {
      "index": 112,
      "start": "00:23:04.300",
      "end": "00:23:05.950",
      "text": "Well, I'd like these quotes separately."
    },
    {
      "index": 113,
      "start": "00:23:05.950",
      "end": "00:23:08.000",
      "text": "Sure, we can do that."
    },
    {
      "index": 114,
      "start": "00:23:08.000",
      "end": "00:23:11.430",
      "text": "All three of them separate."
    },
    {
      "index": 115,
      "start": "00:23:11.430",
      "end": "00:24:10.160",
      "text": "Okay, that'll just take a few minutes."
    },
    {
      "index": 116,
      "start": "00:24:10.160",
      "end": "00:24:11.320",
      "text": "Okay, so we're doing third reading"
    },
    {
      "index": 117,
      "start": "00:24:11.320",
      "end": "00:24:15.420",
      "text": "of the confirming bylaw first, same mover and seconder."
    },
    {
      "index": 118,
      "start": "00:24:15.420",
      "end": "00:24:16.370",
      "text": "I'm gonna open third reading"
    },
    {
      "index": 119,
      "start": "00:24:16.370",
      "end": "00:24:32.020",
      "text": "of the confirming bylaw for voting."
    },
    {
      "index": 120,
      "start": "00:24:32.020",
      "end": "00:24:39.520",
      "text": "Councilor votes yes."
    },
    {
      "index": 121,
      "start": "00:24:39.520",
      "end": "00:24:43.910",
      "text": "Closing the vote, motion carries 14 to zero."
    },
    {
      "index": 122,
      "start": "00:24:43.910",
      "end": "00:24:49.350",
      "text": "Okay, and next we will do bill 332,"
    },
    {
      "index": 123,
      "start": "00:24:49.350",
      "end": "00:24:54.270",
      "text": "which is the item related to the transit village place types."
    },
    {
      "index": 124,
      "start": "00:24:54.270",
      "end": "00:24:59.360",
      "text": "So that'll be third reading of that item."
    },
    {
      "index": 125,
      "start": "00:24:59.360",
      "end": "00:25:08.960",
      "text": "I'll open that for voting."
    },
    {
      "index": 126,
      "start": "00:25:08.960",
      "end": "00:25:14.580",
      "text": "Councilor votes yes."
    },
    {
      "index": 127,
      "start": "00:25:14.580",
      "end": "00:25:17.920",
      "text": "Closing the vote, motion carries 14 to zero."
    },
    {
      "index": 128,
      "start": "00:25:17.920",
      "end": "00:25:20.690",
      "text": "And finally we'll do bill 333,"
    },
    {
      "index": 129,
      "start": "00:25:20.690",
      "end": "00:25:24.880",
      "text": "which is a bill related to amend our ZEQ1 bylaw"
    },
    {
      "index": 130,
      "start": "00:25:24.880",
      "end": "00:25:29.660",
      "text": "to add a new zone, DSA, and relevant regulations"
    },
    {
      "index": 131,
      "start": "00:25:29.660",
      "end": "00:25:31.990",
      "text": "that apply to the new zones for lands located"
    },
    {
      "index": 132,
      "start": "00:25:31.990",
      "end": "00:25:35.200",
      "text": "within the protected major transit station areas"
    },
    {
      "index": 133,
      "start": "00:25:35.200",
      "end": "00:25:36.550",
      "text": "within the city of London."
    },
    {
      "index": 134,
      "start": "00:25:36.550",
      "end": "00:25:39.670",
      "text": "We'll open that for third reading."
    },
    {
      "index": 135,
      "start": "00:25:39.670",
      "end": "00:25:52.720",
      "text": "Councilor votes no."
    },
    {
      "index": 136,
      "start": "00:25:52.720",
      "end": "00:25:57.760",
      "text": "Councilor Palosa, closing the vote,"
    },
    {
      "index": 137,
      "start": "00:25:57.760",
      "end": "00:26:02.130",
      "text": "motion carries 13 to one."
    },
    {
      "index": 138,
      "start": "00:26:02.130",
      "end": "00:26:04.420",
      "text": "And with that, it brings us to a motion to adjourn."
    },
    {
      "index": 139,
      "start": "00:26:04.420",
      "end": "00:26:06.800",
      "text": "I'll look for mover and seconder, Councilor Hillier,"
    },
    {
      "index": 140,
      "start": "00:26:06.800",
      "end": "00:26:08.650",
      "text": "seconder by Councilor Ferrera."
    },
    {
      "index": 141,
      "start": "00:26:08.650",
      "end": "00:26:10.950",
      "text": "We will do that by hand."
    },
    {
      "index": 142,
      "start": "00:26:10.950",
      "end": "00:26:15.870",
      "text": "Okay, all those in favor of adjournment, any opposed?"
    },
    {
      "index": 143,
      "start": "00:26:15.870",
      "end": "00:26:17.220",
      "text": "Motion carries."
    },
    {
      "index": 144,
      "start": "00:26:17.220",
      "end": "00:26:18.060",
      "text": "All right, thank you."
    },
    {
      "index": 145,
      "start": "00:26:18.060",
      "end": "00:26:18.460",
      "text": "We're adjourned."
    }
  ],
  "transcript_source": "lillian_skinner_archive",
  "transcript_source_url": "https://london.lillianskinner.ca/Meetings/Council/2025/08-12/.transcript.srt"
}