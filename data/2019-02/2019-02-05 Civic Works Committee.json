class__": "Paragraph"}, {"string": "- a communication from R. Hudon, Safe Water Ottawa", "__class__": "Paragraph"}, {"string": "- a communication from K. Spencer", "__class__": "Paragraph"}, {"string": "- a communication from D. Mayne", "__class__": "Paragraph"}, {"string": "- a communication from C. Hibbs, Ontario Dental Assistants Association", "__class__": "Paragraph"}, {"string": "- a communication from A. Richard, Canadian Association of Public\u00a0\u00a0\u00a0 Dentistry", "__class__": "Paragraph"}, {"string": "- a communication from M. Carter, Ontario Dental Hygienists Association", "__class__": "Paragraph"}, {"string": "- a communication from Dr. F. Rashid, Ontario Association of Public Health Dentistry", "__class__": "Paragraph"}, {"string": "- a communication from O. Love, Canadian Dental Hygienists Association", "__class__": "Paragraph"}, {"string": "- a communication from , A. Sherban, Royal College of Dental Surgeons of Ontario", "__class__": "Paragraph"}, {"string": "- a communication Dr. H. Limeback, University of Toronto", "__class__": "Paragraph"}, {"string": "- communications from C. Massey", "__class__": "Paragraph"}, {"string": "- a communication from R. Dickson, Safe Water Calgary", "__class__": "Paragraph"}, {"string": "- a communication from M. Lucas", "__class__": "Paragraph"}, {"string": "- a communication from Dr. M. Gross, London and District Dental Association", "__class__": "Paragraph"}, {"string": "- communications from L. Cianchino", "__class__": "Paragraph"}, {"string": "- a communication from Saleem Family", "__class__": "Paragraph"}, {"string": "- a communication and delegation from P. Killen", "__class__": "Paragraph"}, {"string": "- a delegation from L. Timler, School of Health Sciences, Fanshawe College", "__class__": "Paragraph"}, {"string": "b)\u00a0\u00a0 \u00a0the City Engineer, in consultation with the Middlesex London Health Unit, BE REQUESTED to report back at a future meeting of the Civic Works Committee with respect to the potential to lower the fluoridation levels in the London drinking water to 0.6 mg/L; (2019-E15)", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "Voting Record:", "__class__": "Paragraph"}], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by M. van Holst", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "The additional requests for Delegation Status with respect to the above matter from the following\u00a0BE GRANTED :", "__class__": "Paragraph"}, {"string": "- P. Killen", "__class__": "Paragraph"}, {"string": "- L. Cianchino", "__class__": "Paragraph"}, {"string": "- N. Kuzmanovich", "__class__": "Paragraph"}, {"string": "- L.Timler, School of Health Sciences, Fanshawe College", "__class__": "Paragraph"}, {"string": "- M.Czechowicz", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["P. Squire", "M. van Holst", "S. Lewis", "S. Lehman", "E. Peloza", "E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (6 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by E. Peloza", "__class__": "Mover"}, "motion_texts": [{"string": "That the following action be taken with respect to fluoridation in London drinking water:", "__class__": "Paragraph"}, {"string": "a)\u00a0\u00a0\u00a0 \u00a0the delegations and submissions heard at the meeting, BE RECEIVED.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by S. Lewis", "__class__": "Mover"}, "seconded_by