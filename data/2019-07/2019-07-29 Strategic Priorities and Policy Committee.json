icy Committee convene in Closed Session for the purpose of considering a\u00a0matter pertaining to a trade secret or scientific, technical, commercial, financial or labour relations information, supplied in confidence to the municipality or local board, which, if disclosed, could reasonably be expected to prejudice significantly the competitive position or interfere significantly with the contractual or other negotiations of a person, group of persons, or organization; a matter pertaining to an identifiable individual; employment-related matters; advice that is subject to solicitor-client privilege, including communications necessary for that purpose; advice or recommendations of officers and employees of the Corporation, including communications necessary for that purpose and for the purpose of providing instructions and directions to officers and employees of the Corporation.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["S. Lewis", "S. Hillier", "E. Peloza", "S. Lehman", "Mayor E. Holder", "M. van Holst", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins,S. Turner"]}, {"vote": "Absent:", "voters": ["A. Kayabaga", "P. Van Meerbergen,M. Salih"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (12 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [{"string": "The Strategic Priorities and Policy Committee\u00a0convened In Closed Session from 7:44 PM to 10:44 PM.", "__class__": "Paragraph"}], "__class__": "Motion"}], "items": {}, "datetime": "2019-07-29 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "datetime": "2019-07-29 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "7": {"title": "Adjournment", "number": "7", "content": [{"string": "The meeting adjourned at 10:45 PM.", "__class__": "Paragraph"}], "items": {}, "datetime": "2019-07-29 16:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}}, "__class__": "Meeting"}