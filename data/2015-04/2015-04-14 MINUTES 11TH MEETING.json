graph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "15": {"title": "Confirmation of\n  Appointment to the Accessibility Advisory Committee", "number": "15", "content": [{"string": "That Ashfaq Husain representing Ontarians\n  with Disabilities Act Regional Committee BE CONFIRMED as a Non-Voting Member\n  to the Accessibility Advisory Committee for the term ending February 28,\n  2019.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "16": {"title": "Confirmation of\n  Appointment to the Community Safety and Crime Prevention Advisory Committee", "number": "16", "content": [{"string": "That Sheila Amri representing Youth between\n  the ages of 18 and 25 BE CONFIRMED as a Voting Member to the Community Safety\n  and Crime Prevention Advisory Committee for the term ending February 28,\n  2019.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "6": {"title": "London & Middlesex Housing Corporation\n  2015 Shareholder\u2019s Meeting Request", "number": "6", "content": [], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "8": {"title": "Nomination of Individuals for Appointment\n  to the London Downtown Business Association for the term ending November 30,\n  2018", "number": "8", "content": [{"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher (12) RECUSED: P. Hubert (1)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion