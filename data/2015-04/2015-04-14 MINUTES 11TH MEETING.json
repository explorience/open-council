class__": "MeetingItem"}, "XI": {"title": "ENQUIRIES", "number": "XI", "content": [{"string": "Councillor Morgan enquires if the Civic\n  Administration could investigate and report back on the appropriate\n  procedures to be followed and how to best engage with non-Committee members\n  at Standing Committee meetings, and doing the \"committee work\" at\n  committee meetings, as opposed to at the Council meeting.\u00a0 His Worship the Mayor\n  advises that this matter will be considered by the Governance Working Group.", "__class__": "Paragraph"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XII": {"title": "EMERGENT\n  MOTIONS", "number": "XII", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor M. Cassidy", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor V. Ridley", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that pursuant to section 19.2 of\n  the Council Procedure By-law, leave be given for the introduction of an emergent\n  motion regarding a request from Bethanys Hope Foundation and Jones\n  Entertainment Group to amend the 2015 Special Events Policies &\n  Procedures Manual to provide for the use of Harris Park for five consecutive\n  days (July 14 to July 18, 2015).", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Mayor M. Brown and seconded\n  by Councillor M. Salih", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Approve that the following actions be taken with\n  respect to the request from Bethanys Hope Foundation and Jones Entertainment\n  Group to amend the 2015 Special Events Policies & Procedures Manual to\n  provide for the use of Harris Park for five consecutive days (July 14 to July\n  18, 2015) for the Rock the Park 12 \u2013 July 2015 event:\n\u00a0\na)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the\n  City Clerk BE DIRECTED to prepare a draft by-law to be considered at the\n  April 21, 2015 Community and Protective Services Committee to amend the 2015\n  Special Events Policies & Procedures Manual to permit Bethanys Hope\n  Foundation and Jones Entertainment Group the use of Harris Park for five\n  consecutive days (July 14 to July 18, 2015) for the Rock the Park 12 \u2013 July\n  2015 event; and\n\u00a0\nb)\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 the\n  City Clerk BE DIRECTED to make the necessary arrangements to provide for the\n  receipt of delegations at the April 21, 2015 Community and Protective\n  Services Committee meeting to receive comments regarding the request noted in\n  a) above.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "P. Squire", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher (13)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": null, "attachments": [], "report": null, "__class__": "MeetingItem"}, "XIII": {"title": "BY-LAWS", "number": "XIII", "content": [{"string": "BY-LAWS TO BE READ A FIRST, SECOND AND\n  THIRD TIME:", "__class__": "Paragraph"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor V. Ridley", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by Councillor P. Hubert", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Introduction and First Reading of\n  Bill No.s 147 to 163, excluding Bill No. 149.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Motion Passed", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Brown", "M. van Holst", "B. Armstrong", "M. Salih", "J. Helmer", "M. Cassidy", "J. Morgan", "P. Hubert", "A. Hopkins", "V. Ridley", "S. Turner", "H.L. Usher (12)"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "Moved by Councillor H.L. Usher and seconded\n  by Councillor J. Morgan", "__class__": "Mover"}, "seconded_by": {"string": "", "__class__": "Mover"}, "motion_texts": [{"string": "Approve Second Reading of Bill No.s 147 to 163,\n  excluding Bill No. 149.", "__class__": "Paragraph"}], "vote": {"rows": [], "__class__": "Vote"}, "result": {"string": "", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}, {"pre_motion_texts": [], "moved_by": {"string": "", "__class__": "Mov