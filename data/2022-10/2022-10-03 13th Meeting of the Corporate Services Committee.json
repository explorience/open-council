{"title": "13th Meeting of the Corporate Services Committee", "datetime": "2022-10-03 12:00:00", "url": "https://pub-london.escribemeetings.com/Meeting.aspx?Id=dc5c99a4-6aa6-4d8d-bbdd-c39c722482ff&Agenda=PostMinutes&lang=English", "meeting_type": "Corporate Services Committee", "bills": null, "present": ["S. Lewis", "M. Cassidy", "J. Morgan", "M. Hamou", "J. Fyfe-Millar"], "also_present": ["J. Taylor", "B. Westlake-Power"], "remote_attendance": ["S. Hillier", "L. Livingstone", "A. Barbon", "M. Butlin", "I. Collins", "M. Schulthess"], "content": {"string": "The meeting is called to order at 12:00 PM; it being noted that the Members were in remote attendance, Councillors M. Cassidy, M. Hamou and J. Morgan.", "__class__": "Paragraph"}, "absent": ["E. Holder"], "items": {"1": {"title": "Disclosures of Pecuniary Interest", "number": "1", "content": [{"string": "That it BE NOTED that no pecuniary interests were disclosed.", "__class__": "Paragraph"}], "items": {}, "datetime": "2022-10-03 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "2": {"title": "Consent", "number": "2", "content": [], "items": {"1": {"title": "Appointments and Updates to the Joint Venture Management Committee for the 4-Pad Arena Complex", "number": "1", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by J. Fyfe-Millar", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by M. Cassidy", "__class__": "Mover"}, "motion_texts": [{"string": "That, on the recommendation of the Deputy City Manager, Finance Supports, the following actions be taken with respect to the Joint Venture Management Committee for the 4-Pad Arena Complex:\n\n\n\na) \u00a0 \u00a0the proposed by-law as appended to the staff report dated October 3, 2022 as Appendix \u201cA\u201d BE INTRODUCED at the October 17, 2022 meeting of the Municipal Council to amend By-law No. A.-6567-226 being a by-law to approve the appointment of the City\u2019s representatives to the Joint Venture Management Committee for the 4-Pad Arena Complex located on Western Fair Association (WFA) lands; and,\n\n\n\nb) \u00a0 \u00a0the Western Fair Association\u2019s Chief Executive Officer, and the Director of Racing along with their Director of Corporate Services as an alternative representative BE APPROVED as Western Fair Association\u2019s nominees to the Joint Venture Management Committee.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Cassidy", "J. Morgan", "S. Lewis", "J. Fyfe-Millar,M. Hamou"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Passed (5 to 0)", "__class__": "MotionResult"}, "post_motion_texts": [], "__class__": "Motion"}], "items": {}, "datetime": "2022-10-03 12:00:00", "attachments": [{"empty_flag": false, "title": "2022-10-03 Staff Report - Appointments and Updates to the Joint Venture", "url": "https://pub-london.escribemeetings.com/filestream.ashx?DocumentId=95043", "date": "2022-10-03 00:00:00", "local_page": null, "__class__": "Attachment"}], "report": null, "__class__": "MeetingItem"}}, "datetime": "2022-10-03 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "3": {"title": "Scheduled Items", "number": "3", "content": [{"string": "None.", "__class__": "Paragraph"}], "items": {}, "datetime": "2022-10-03 12:00:00", "attachments": [], "report": null, "__class__": "MeetingItem"}, "4": {"title": "Items for Direction", "number": "4", "content": [{"pre_motion_texts": [], "moved_by": {"string": "Moved by M. Hamou", "__class__": "Mover"}, "seconded_by": {"string": "Seconded by J. Fyfe-Millar", "__class__": "Mover"}, "motion_texts": [{"string": "That Items 4.1 and 4.2 BE APPROVED.", "__class__": "Paragraph"}], "vote": {"rows": [{"vote": "Yeas:", "voters": ["M. Cassidy,J. Morgan"]}, {"vote": "Nays:", "voters": ["S. Lewis", "J. Fyfe-Millar,M. Hamou"]}, {"vote": "Absent:", "voters": ["E. Holder"]}], "__class__": "Vote"}, "result": {"string": "Motion Fa